        },
    ];

      const apartmentTypes = {
        A: {
          area: 137,
          directionAr: "بحري قبلي",
          directionEn: "North/South Facing",
          basePrice: 1849500,
          features: [
            "Wide layout",
            "Large area",
            "Good ventilation",
            "Private reservation",
            "Elevator access",
          ],
        },
        B: {
          area: 125,
          directionAr: "بحري",
          directionEn: "North Facing",
          basePrice: 1750000,
          features: [
            "North-facing unit",
            "Premium finishing",
            "Family-friendly space",
            "Elevator access",
          ],
        },
        C: {
          area: 120,
          directionAr: "قبلي",
          directionEn: "South Facing",
          basePrice: 1560000,
          features: [
            "South-facing unit",
            "Good ventilation",
            "Family-friendly space",
            "Private reservation",
          ],
        },
      };

      function createApartmentData() {
        const apartments = [];
        for (let floor = 1; floor <= 7; floor += 1) {
          ["A", "B", "C"].forEach((type) => {
            const spec = apartmentTypes[type];
            apartments.push({
              id: `apt_${type}${floor}01`,
              unitCode: `${type}${floor}01`,
              floorNumber: floor,
              apartmentType: type,
              area: spec.area,
              directionAr: spec.directionAr,
              directionEn: spec.directionEn,
              price: spec.basePrice + (floor - 1) * 35000,
              status: "Available",
              assignedClientId: null,
              buildingName: "مشروع أرض عبدالجليل",
              location: project.location,
              notes:
                type === "A"
                  ? "Premium larger unit"
                  : "Standard premium residential unit",
              features: spec.features,
            });
          });
        }
        return apartments;
      }

      const reservationState = {
        adminUnlocked: false,
        selectedApartmentId: null,
        searchTerm: "",
        activeFilter: "All",
        apartments: [],
        clients: [],
        payments: [],
        installments: [],
        auditLogs: [],
        settings: {},
        summary: null,
      };

      const numberFormatter = new Intl.NumberFormat("ar-EG");
      const percentFormatter = new Intl.NumberFormat("ar-EG", {
        maximumFractionDigits: 0,
      });
      const dateFormatter = new Intl.DateTimeFormat("ar-EG", {
        day: "numeric",
        month: "long",
        year: "numeric",
      });
      const monthFormatter = new Intl.DateTimeFormat("ar-EG", {
        month: "long",
        year: "numeric",
      });

      const toArabicNumber = (value) =>
        numberFormatter.format(Math.max(0, value));
      const formatPercent = (value) => `${percentFormatter.format(value)}٪`;
      const formatDate = (value) => dateFormatter.format(new Date(value));
      const formatMoney = (value) =>
        `${new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(Math.max(0, Math.round(value || 0)))} EGP`;
      const formatMoneyAr = (value) =>
        `${new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(Math.max(0, Math.round(value || 0)))} جنيه`;

      const escapeHTML = (value) =>
        String(value ?? "").replace(
          /[&<>"']/g,
          (char) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#039;",
            })[char],
        );

      const slugStatus = (status) =>
        String(status || "")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-|-$/g, "");

      function StatusBadge(status, kind = "apartment") {
        return `<span class="status-badge status-${slugStatus(status)}">${escapeHTML(translateStatus(status, kind))}</span>`;
      }

      const reservationStatusAr = {
        Available: "متاحة",
        Pending: "قيد المراجعة",
        Reserved: "محجوزة",
        Confirmed: "مؤكدة",
        Sold: "مباعة",
        Cancelled: "ملغاة",
      };

      const apartmentStatusAr = {
        Available: "متاحة",
        Reserved: "محجوزة",
        Sold: "مباعة",
        "Pending Payment": "في انتظار السداد",
      };

      const paymentStatusAr = {
        "Fully Paid": "مدفوع بالكامل",
        "Partially Paid": "مدفوع جزئيًا",
        Pending: "في انتظار الدفع",
        Overdue: "متأخر السداد",
      };

      const paymentMethodAr = {
        Cash: "نقدًا",
        "Bank Transfer": "تحويل بنكي",
        Installment: "قسط",
        "Office Payment": "دفع في المكتب",
        Other: "أخرى",
      };

      const paymentRecordStatusAr = {
        Confirmed: "مؤكد",
        Pending: "قيد المراجعة",
        Rejected: "مرفوض",
      };

      const featureAr = {
        "Wide layout": "توزيع واسع",
        "Premium finishing": "تشطيب فاخر",
        "Good ventilation": "تهوية ممتازة",
        "Family-friendly space": "مساحة مناسبة للعائلة",
        "North-facing unit": "واجهة بحري",
        "South-facing unit": "واجهة قبلي",
        "Large area": "مساحة كبيرة",
        "Private reservation": "حجز خاص",
        "Elevator access": "وصول بالمصعد",
      };

      function translateStatus(status, kind = "reservation") {
        const maps = {
          reservation: reservationStatusAr,
          apartment: apartmentStatusAr,
          payment: paymentStatusAr,
          paymentRecord: paymentRecordStatusAr,
          method: paymentMethodAr,
        };
        return maps[kind]?.[status] || status;
      }

      function ArabicStatusBadge(status, kind) {
        return `<span class="status-badge status-${slugStatus(status)}">${escapeHTML(translateStatus(status, kind))}</span>`;
      }

      function apartmentTypeArabic(apartment) {
        return `شقة ${toArabicNumber(apartment.area)} متر — ${escapeHTML(apartment.directionAr)}`;
      }

      function clientPaymentMessage(client) {
        if (client.paymentStatus === "Fully Paid") {
          return "تم سداد قيمة الحجز بالكامل. شكرًا لتعاملكم معنا.";
        }
        if (client.paymentStatus === "Overdue") {
          return "يوجد مبلغ مستحق متأخر. يرجى التواصل مع المكتب لمراجعة التفاصيل.";
        }
        if (client.paymentStatus === "Partially Paid") {
          return "تم سداد جزء من قيمة الحجز، والمتبقي موضح في ملخص الدفع.";
        }
        return "لم يتم تسجيل دفعة مؤكدة بعد، وسيظهر أي تحديث في ملخص الدفع فور اعتماده من المكتب.";
      }

      function clientReservationMessage(client) {
        if (["Confirmed", "Sold", "Reserved"].includes(client.reservationStatus)) {
          return "تم تأكيد حجز الشقة الخاصة بك. يمكنك متابعة تفاصيل الشقة والمدفوعات من خلال هذه الصفحة.";
        }
        if (client.reservationStatus === "Pending") {
          return "طلب الحجز قيد المراجعة، وسيتم تحديث الحالة بعد مراجعة المكتب.";
        }
        if (client.reservationStatus === "Cancelled") {
          return "تم إلغاء هذا الحجز. يرجى التواصل مع المكتب إذا كنت بحاجة إلى مراجعة التفاصيل.";
        }
        return "يمكنك متابعة تفاصيل الشقة والمدفوعات من خلال هذه الصفحة.";
      }

      function whatsappClientLink(client) {
        const text = `مرحبًا، أريد الاستفسار عن الحجز الخاص بي. كود الحجز: ${client.code}`;
        return `https://wa.me/${project.whatsappNumber}?text=${encodeURIComponent(text)}`;
      }

      function ProgressBar(
        percent,
        label = "نسبة السداد",
        ariaLabel = "نسبة السداد",
      ) {
        const cleanPercent = Math.min(
          100,
          Math.max(0, Math.round(percent || 0)),
        );
        return `
        <div class="progress-line">
          <div class="progress-line-head">
            <span>${escapeHTML(label)}</span>
            <strong>${formatPercent(cleanPercent)}</strong>
          </div>
          <div class="light-progress-track" aria-label="${escapeHTML(ariaLabel)} ${cleanPercent}%">
            <div class="light-progress-fill" style="width:${cleanPercent}%"></div>
          </div>
        </div>
      `;
      }

      function getApartment(apartmentId) {
        return reservationState.apartments.find(
          (apartment) => apartment.id === apartmentId,
        );
      }

      function getClientById(clientId) {
        return reservationState.clients.find(
          (client) => client.id === clientId,
        );
      }

      function getClientForApartment(apartmentId) {
        return reservationState.clients.find(
          (client) =>
            client.apartmentId === apartmentId &&
            client.reservationStatus !== "Cancelled",
        );
      }

      function getConfirmedPaid(client) {
        return (client.payments || [])
          .filter((payment) => payment.status === "Confirmed")
          .reduce((sum, payment) => sum + Number(payment.amount || 0), 0);
      }

      function getLastPaymentDate(client) {
        const confirmed = (client.payments || []).filter(
          (payment) => payment.status === "Confirmed",
        );
        if (!confirmed.length) return null;
        return confirmed.sort((a, b) => new Date(b.date) - new Date(a.date))[0]
          .date;
      }

      function calculateClientFinancials(client) {
        const apartment = getApartment(client.apartmentId);
        const totalAmount = apartment
          ? Number(apartment.price || 0)
          : Number(client.totalAmount || 0);
        const paidAmount = getConfirmedPaid(client);
        const remainingAmount = Math.max(0, totalAmount - paidAmount);
        const paymentProgress =
          totalAmount > 0 ? Math.min(100, (paidAmount / totalAmount) * 100) : 0;
        let paymentStatus = "Pending";

        if (client.overdue && remainingAmount > 0) {
          paymentStatus = "Overdue";
        } else if (paidAmount >= totalAmount && totalAmount > 0) {
          paymentStatus = "Fully Paid";
        } else if (paidAmount > 0) {
          paymentStatus = "Partially Paid";
        }

        Object.assign(client, {
          totalAmount,
          paidAmount,
          remainingAmount,
          paymentProgress,
          paymentStatus,
          lastPaymentDate: getLastPaymentDate(client),
        });
      }

      function syncReservationData() {
        reservationState.apartments.forEach((apartment) => {
          apartment.assignedClientId = null;
          if (
            !["Sold", "Reserved", "Pending Payment"].includes(apartment.status)
          ) {
            apartment.status = "Available";
          }
        });

        reservationState.clients.forEach((client) => {
          calculateClientFinancials(client);
          const apartment = getApartment(client.apartmentId);
          if (!apartment || client.reservationStatus === "Cancelled") return;

          apartment.assignedClientId = client.id;
          if (
            client.reservationStatus === "Sold" ||
            client.paymentStatus === "Fully Paid"
          ) {
            apartment.status = "Sold";
          } else if (
            client.paymentStatus === "Pending" ||
            client.paymentStatus === "Overdue"
          ) {
            apartment.status = "Pending Payment";
          } else {
            apartment.status = "Reserved";
          }
        });
      }

      async function apiFetch(path, options = {}) {
        const response = await fetch(path, {
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json",
            ...(options.headers || {}),
          },
          ...options,
        });
        const contentType = response.headers.get("content-type") || "";
        const payload = contentType.includes("application/json")
          ? await response.json()
          : await response.text();
        if (!response.ok) {
          const message =
            typeof payload === "object" && payload?.message
              ? payload.message
              : "لا يمكن تنفيذ العملية. يرجى مراجعة البيانات.";
          throw new Error(message);
        }
        return payload;
      }

      function applyAdminPayload(payload) {
        reservationState.summary = payload.summary || null;
        reservationState.apartments = payload.apartments || [];
        reservationState.clients = payload.clients || [];
        reservationState.payments = payload.payments || [];
        reservationState.installments = payload.installments || [];
        reservationState.auditLogs = payload.auditLogs || [];
        reservationState.settings = payload.settings || {};
        if (reservationState.settings.whatsapp_number) {
          project.whatsappNumber = reservationState.settings.whatsapp_number;
        }
        if (reservationState.settings.office_phone) {
          project.contactPhone = reservationState.settings.office_phone;
        }
        if (!reservationState.selectedApartmentId && reservationState.apartments.length) {
          reservationState.selectedApartmentId = reservationState.apartments[0].id;
        }
      }

      async function loadAdminData() {
        const payload = await apiFetch("/api/admin/bootstrap");
        applyAdminPayload(payload);
        renderAdminDashboard();
        return payload;
      }

      async function restoreAdminSession() {
        try {
          await loadAdminData();
          reservationState.adminUnlocked = true;
          document.getElementById("adminGate").style.display = "none";
          document.getElementById("adminDashboard").classList.add("show");
        } catch {
          reservationState.adminUnlocked = false;
        }
      }

      async function findClientByCode(code) {
        const normalized = String(code || "")
          .trim()
          .toUpperCase();
        if (!normalized) return null;

        const payload = await apiFetch("/api/client/verify-code", {
          method: "POST",
          body: JSON.stringify({ code: normalized }),
        });
        const client = payload.client;
        if (payload.settings?.whatsappNumber) {
          project.whatsappNumber = payload.settings.whatsappNumber;
        }
        if (payload.settings?.officePhone) {
          project.contactPhone = payload.settings.officePhone;
        }
        reservationState.clients = client ? [client] : [];
        reservationState.apartments = client?.apartment ? [client.apartment] : [];
        return client || null;
      }

      function PaymentSummaryCard(client) {
        return `
        <article class="premium-card" dir="rtl">
          <div class="dashboard-topline">
            <div>
              <h3>ملخص الدفع</h3>
              <p>${escapeHTML(clientPaymentMessage(client))}</p>
            </div>
            ${ArabicStatusBadge(client.paymentStatus, "payment")}
          </div>
          <div class="payment-numbers">
            <div class="money-box">
              <span>السعر الإجمالي</span>
              <strong>${formatMoneyAr(client.totalAmount)}</strong>
            </div>
            <div class="money-box">
              <span>المبلغ المدفوع</span>
              <strong>${formatMoneyAr(client.paidAmount)}</strong>
            </div>
            <div class="money-box">
              <span>المبلغ المتبقي</span>
              <strong>${formatMoneyAr(client.remainingAmount)}</strong>
            </div>
          </div>
          ${ProgressBar(client.paymentProgress, "نسبة السداد", "نسبة السداد")}
          <div class="detail-list">
            <div class="detail-item">
              <span>آخر دفعة</span>
              <strong>${client.lastPaymentDate ? formatDate(client.lastPaymentDate) : "لا توجد دفعات مؤكدة"}</strong>
            </div>
            <div class="detail-item">
              <span>حالة الدفع</span>
              <strong>${escapeHTML(translateStatus(client.paymentStatus, "payment"))}</strong>
            </div>
          </div>
        </article>
      `;
      }

      function PaymentHistoryTable(payments = []) {
        if (!payments.length) {
          return `<div class="empty-state" dir="rtl">لا توجد مدفوعات مسجلة لهذا الحجز حتى الآن.</div>`;
        }

        return `
        <table class="payment-table" dir="rtl">
          <thead>
            <tr>
              <th>التاريخ</th>
              <th>المبلغ</th>
              <th>طريقة الدفع</th>
              <th>الحالة</th>
              <th>رقم الإيصال</th>
              <th>ملاحظات</th>
            </tr>
          </thead>
          <tbody>
            ${payments
              .map(
                (payment) => `
              <tr>
                <td data-label="التاريخ">${formatDate(payment.date)}</td>
                <td data-label="المبلغ">${formatMoneyAr(payment.amount)}</td>
                <td data-label="طريقة الدفع">${escapeHTML(paymentMethodAr[payment.method] || payment.method)}</td>
                <td data-label="الحالة">${ArabicStatusBadge(payment.status, "paymentRecord")}</td>
                <td data-label="رقم الإيصال">${escapeHTML(payment.reference || "غير متوفر")}</td>
                <td data-label="ملاحظات">${escapeHTML(payment.notes || "لا توجد ملاحظات")}</td>
              </tr>
            `,
              )
              .join("")}
          </tbody>
        </table>
      `;
      }

      const installmentStatusAr = {
        upcoming: "قادم",
        due: "مستحق",
        paid: "مدفوع",
        partially_paid: "مدفوع جزئيًا",
        overdue: "متأخر",
        cancelled: "ملغي",
      };

      function InstallmentSchedule(installments = []) {
        if (!installments.length) {
          return `<div class="empty-state" dir="rtl">لا يوجد جدول أقساط مسجل لهذا الحجز.</div>`;
        }
        return `
          <table class="payment-table" dir="rtl">
            <thead>
              <tr>
                <th>رقم القسط</th>
                <th>تاريخ الاستحقاق</th>
                <th>قيمة القسط</th>
                <th>المدفوع</th>
                <th>المتبقي</th>
                <th>الحالة</th>
                <th>ملاحظات</th>
              </tr>
            </thead>
            <tbody>
              ${installments.map((item) => `
                <tr>
                  <td data-label="رقم القسط">${toArabicNumber(item.installmentNumber)}</td>
                  <td data-label="تاريخ الاستحقاق">${formatDate(item.dueDate)}</td>
                  <td data-label="قيمة القسط">${formatMoneyAr(item.amount)}</td>
                  <td data-label="المدفوع">${formatMoneyAr(item.paidAmount)}</td>
                  <td data-label="المتبقي">${formatMoneyAr(item.remainingAmount)}</td>
                  <td data-label="الحالة">${escapeHTML(installmentStatusAr[item.status] || item.status)}</td>
                  <td data-label="ملاحظات">${escapeHTML(item.notes || "لا توجد ملاحظات")}</td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        `;
      }

      function ApartmentDetailsCard(apartment, client) {
        return `
        <article class="premium-card" dir="rtl">
          <h4>تفاصيل الشقة</h4>
          <div class="apartment-card-layout">
            <div class="apartment-visual">
              <span>رقم الوحدة</span>
              <strong class="unit-code-large">${escapeHTML(apartment.unitCode)}</strong>
            </div>
            <div>
              <div class="detail-list">
                <div class="detail-item">
                  <span>رقم الوحدة</span>
                  <strong>${escapeHTML(apartment.unitCode)}</strong>
                </div>
                <div class="detail-item">
                  <span>الدور</span>
                  <strong>${toArabicNumber(apartment.floorNumber)}</strong>
                </div>
                <div class="detail-item">
                  <span>نوع الشقة</span>
                  <strong>${apartmentTypeArabic(apartment)}</strong>
                </div>
                <div class="detail-item">
                  <span>المساحة</span>
                  <strong>${toArabicNumber(apartment.area)} م²</strong>
                </div>
                <div class="detail-item">
                  <span>الاتجاه</span>
                  <strong>${escapeHTML(apartment.directionAr)}</strong>
                </div>
                <div class="detail-item">
                  <span>حالة الشقة</span>
                  <strong>${escapeHTML(translateStatus(apartment.status, "apartment"))}</strong>
                </div>
                <div class="detail-item">
                  <span>السعر الإجمالي</span>
                  <strong>${formatMoneyAr(client.totalAmount)}</strong>
                </div>
                <div class="detail-item">
                  <span>المدفوع</span>
                  <strong>${formatMoneyAr(client.paidAmount)}</strong>
                </div>
                <div class="detail-item">
                  <span>المتبقي</span>
                  <strong>${formatMoneyAr(client.remainingAmount)}</strong>
                </div>
                <div class="detail-item">
                  <span>اسم المبنى</span>
                  <strong>${escapeHTML(apartment.buildingName)}</strong>
                </div>
                <div class="detail-item">
                  <span>الموقع</span>
                  <strong>${escapeHTML(apartment.location)}</strong>
                </div>
              </div>
              <div class="feature-list">
                ${(apartment.features || []).map((feature) => `<span class="feature-pill">${escapeHTML(featureAr[feature] || feature)}</span>`).join("")}
              </div>
            </div>
          </div>
        </article>
      `;
      }

      function ClientReservationDashboard(client) {
        const apartment = getApartment(client.apartmentId);
        if (!apartment) {
          return `<div class="empty-state" dir="rtl">بيانات الشقة غير متاحة حالياً. يرجى التواصل مع المكتب.</div>`;
        }

        return `
        <div class="dashboard-topline" dir="rtl">
          <div>
            <h3>بيانات العميل</h3>
            <p>مرحبًا ${escapeHTML(client.name)}، هذه الصفحة تعرض بيانات حجزك فقط.</p>
          </div>
          ${ArabicStatusBadge(client.reservationStatus, "reservation")}
        </div>

        <div class="portal-note" dir="rtl" style="margin:0 0 14px">
          ${escapeHTML(clientReservationMessage(client))}
          <br />
          ${escapeHTML(clientPaymentMessage(client))}
        </div>

        <div class="info-strip" dir="rtl">
          <div class="info-chip">
            <span>اسم العميل</span>
            <strong>${escapeHTML(client.name)}</strong>
          </div>
          <div class="info-chip">
            <span>كود الحجز</span>
            <strong>${escapeHTML(client.code)}</strong>
          </div>
          <div class="info-chip">
            <span>حالة الحجز</span>
            <strong>${escapeHTML(translateStatus(client.reservationStatus, "reservation"))}</strong>
          </div>
          <div class="info-chip">
            <span>تاريخ الحجز</span>
            <strong>${formatDate(client.reservationDate)}</strong>
          </div>
          <div class="info-chip">
            <span>تاريخ الاستلام المتوقع</span>
            <strong>${client.expectedDeliveryDate ? formatDate(client.expectedDeliveryDate) : "لم يتم تحديده"}</strong>
          </div>
          <div class="info-chip">
            <span>رقم الوحدة</span>
            <strong>${escapeHTML(apartment.unitCode)}، الدور ${toArabicNumber(apartment.floorNumber)}</strong>
          </div>
        </div>

        <div class="dashboard-grid" dir="rtl">
          <div>
            ${ApartmentDetailsCard(apartment, client)}
            <article class="premium-card" style="margin-top:14px">
              <h4>سجل المدفوعات</h4>
              ${PaymentHistoryTable(client.payments)}
            </article>
            <article class="premium-card" style="margin-top:14px">
              <h4>جدول الأقساط</h4>
              ${InstallmentSchedule(client.installments)}
            </article>
          </div>
          <div>
            ${PaymentSummaryCard(client)}
            <article class="premium-card" style="margin-top:14px">
              <h4>ملاحظات المكتب</h4>
              <p>${escapeHTML(client.officeNotes || "لا توجد ملاحظات من المكتب لهذا الحجز.")}</p>
              <div class="detail-list">
                <div class="detail-item">
                  <span>اسم المبنى</span>
                  <strong>${escapeHTML(apartment.buildingName)}</strong>
                </div>
                <div class="detail-item">
                  <span>الموقع</span>
                  <strong>${escapeHTML(apartment.location)}</strong>
                </div>
              </div>
            </article>
            <article class="premium-card" style="margin-top:14px">
              <h4>تحميل كشف الحجز</h4>
              <p>يمكنك تحميل كشف الحجز للاحتفاظ بنسخة من بيانات الشقة والمدفوعات.</p>
              <div class="contact-actions">
                <a class="btn primary" href="${whatsappClientLink(client)}" target="_blank" rel="noopener">التواصل مع المكتب عبر واتساب</a>
                <button class="btn secondary" type="button" data-statement-client="${client.id}">تحميل كشف الحجز</button>
              </div>
            </article>
          </div>
        </div>
      `;
      }

      function renderClientDashboard(client) {
        const dashboard = document.getElementById("clientDashboard");
        dashboard.innerHTML = ClientReservationDashboard(client);
        dashboard.classList.add("show");
        dashboard.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function downloadReservationStatement(clientId) {
        const client = getClientById(clientId);
        if (!client) return;
        window.open(
          `/api/client/statement/${encodeURIComponent(client.id)}?code=${encodeURIComponent(client.code)}`,
          "_blank",
          "noopener",
        );
      }

      function getFilteredApartments() {
        const term = reservationState.searchTerm.trim().toLowerCase();
        const filter = reservationState.activeFilter;

        return reservationState.apartments.filter((apartment) => {
          const client = getClientForApartment(apartment.id);
          const haystack = [
            apartment.unitCode,
            apartment.floorNumber,
            apartment.apartmentType,
            apartment.directionAr,
            apartment.directionEn,
            apartment.status,
            client?.name,
            client?.code,
            client?.paymentStatus,
            client?.reservationStatus,
          ]
            .join(" ")
            .toLowerCase();

          const matchesTerm = !term || haystack.includes(term);
          const matchesFilter =
            filter === "All" ||
            apartment.status === filter ||
            client?.paymentStatus === filter ||
            client?.reservationStatus === filter;

          return matchesTerm && matchesFilter;
        });
      }

      function ApartmentUnitCard(apartment) {
        const client = getClientForApartment(apartment.id);
        const progress = client ? Math.round(client.paymentProgress) : 0;
        return `
        <button class="unit-card ${reservationState.selectedApartmentId === apartment.id ? "selected" : ""}" type="button" data-apartment-id="${apartment.id}" data-status="${escapeHTML(apartment.status)}" aria-label="Open apartment ${apartment.unitCode}">
          <div class="unit-head">
            <strong>${escapeHTML(apartment.unitCode)}</strong>
            ${StatusBadge(apartment.status, "apartment")}
          </div>
          <div class="unit-meta">
            <span>${toArabicNumber(apartment.area)} م² · ${escapeHTML(apartment.directionAr)}</span>
            <span>نوع ${escapeHTML(apartment.apartmentType)} · الدور ${toArabicNumber(apartment.floorNumber)}</span>
          </div>
          <div class="unit-client">${client ? escapeHTML(client.name) : "متاحة للحجز"}</div>
          <div class="mini-money">
            <span>المدفوع: ${client ? formatMoneyAr(client.paidAmount) : "٠ جنيه"}</span>
            <span>المتبقي: ${client ? formatMoneyAr(client.remainingAmount) : formatMoneyAr(apartment.price)}</span>
          </div>
          <div class="mini-track" aria-label="Mini payment progress">
            <div class="mini-fill" style="width:${progress}%"></div>
          </div>
        </button>
      `;
      }

      function FloorRow(floorNumber, apartments) {
        const floorApartments = apartments
          .filter((apartment) => apartment.floorNumber === floorNumber)
          .sort((a, b) => a.apartmentType.localeCompare(b.apartmentType));

        if (!floorApartments.length) return "";

        return `
        <div class="floor-row">
          <div class="floor-label">الدور<br>${toArabicNumber(floorNumber)}</div>
          ${floorApartments.map(ApartmentUnitCard).join("")}
        </div>
      `;
      }

      function BuildingAvailabilityMap() {
        const filteredApartments = getFilteredApartments();
        if (!filteredApartments.length) {
          return `<div class="empty-state">لا توجد وحدات مطابقة لبحثك أو الفلتر الحالي.</div>`;
        }

        const floors = [7, 6, 5, 4, 3, 2, 1];
        return floors
          .map((floor) => FloorRow(floor, filteredApartments))
          .join("");
      }

      function ClientTable() {
        const filteredApartments = new Set(
          getFilteredApartments().map((apartment) => apartment.id),
        );
        const filteredClients = reservationState.clients.filter((client) => {
          const apartment = getApartment(client.apartmentId);
          return !apartment || filteredApartments.has(apartment.id);
        });

        if (!filteredClients.length) {
          return `<tr><td colspan="10"><div class="empty-state">لا توجد حجوزات مطابقة للبحث الحالي.</div></td></tr>`;
        }

        return filteredClients
          .map((client) => {
            const apartment = getApartment(client.apartmentId);
            return `
          <tr>
            <td>${escapeHTML(client.name)}</td>
            <td>${escapeHTML(client.code)}</td>
            <td>${apartment ? escapeHTML(apartment.unitCode) : "غير مخصص"}</td>
            <td>${apartment ? toArabicNumber(apartment.floorNumber) : "-"}</td>
            <td>${formatMoneyAr(client.totalAmount)}</td>
            <td>${formatMoneyAr(client.paidAmount)}</td>
            <td>${formatMoneyAr(client.remainingAmount)}</td>
            <td>${ArabicStatusBadge(client.paymentStatus, "payment")}</td>
            <td>${ArabicStatusBadge(client.reservationStatus, "reservation")}</td>
            <td>
              <button class="table-action" type="button" data-client-action="open" data-client-id="${client.id}">عرض</button>
              <button class="table-action" type="button" data-client-action="edit" data-client-id="${client.id}">تعديل</button>
            </td>
          </tr>
        `;
          })
          .join("");
      }

      function renderAdminOverview() {
        const summary = reservationState.summary || {};
        const totalCollected =
          summary.totalCollected ??
          reservationState.clients.reduce((sum, client) => sum + client.paidAmount, 0);
        const totalRemaining =
          summary.totalRemaining ??
          reservationState.clients.reduce((sum, client) => sum + client.remainingAmount, 0);
        const countByStatus = (status) =>
          reservationState.apartments.filter(
            (apartment) => apartment.status === status,
          ).length;
        const overview = [
          ["إجمالي الشقق", summary.totalApartments ?? reservationState.apartments.length],
          ["الشقق المتاحة", summary.availableApartments ?? countByStatus("Available")],
          ["الشقق المحجوزة", summary.reservedApartments ?? countByStatus("Reserved")],
          ["الشقق المباعة", summary.soldApartments ?? countByStatus("Sold")],
          ["إجمالي المبالغ المحصلة", formatMoneyAr(totalCollected)],
          ["إجمالي المبالغ المتبقية", formatMoneyAr(totalRemaining)],
          ["العملاء المتأخرون في السداد", summary.overdueClients ?? 0],
          ["الأقساط القادمة", summary.upcomingInstallments ?? 0],
        ];

        document.getElementById("adminOverview").innerHTML = overview
          .map(
            ([label, value]) => `
        <article class="overview-card">
          <span>${escapeHTML(label)}</span>
          <strong>${typeof value === "number" ? toArabicNumber(value) : escapeHTML(value)}</strong>
        </article>
      `,
          )
          .join("");
      }

      function renderAdminAlerts() {
        const summary = reservationState.summary || {};
        const pendingPaymentApartments = reservationState.apartments.filter(
          (apartment) => apartment.status === "Pending Payment",
        ).length;
        const pendingPayments = summary.pendingPayments || 0;
        const alerts = [
          `عملاء لديهم مبالغ متبقية: ${toArabicNumber(reservationState.clients.filter((client) => client.remainingAmount > 0).length)}`,
          `عملاء متأخرون في السداد: ${toArabicNumber(summary.overdueClients || 0)}`,
          `الأقساط القادمة: ${toArabicNumber(summary.upcomingInstallments || 0)}`,
          `شقق محجوزة في انتظار السداد: ${toArabicNumber(pendingPaymentApartments)}`,
          `دفعات قيد المراجعة: ${toArabicNumber(pendingPayments)}`,
        ];
        document.getElementById("adminAlerts").innerHTML = alerts
          .map((alert) => `<span class="feature-pill">${escapeHTML(alert)}</span>`)
          .join("");
      }

      function renderSelectedUnitPanel() {
        const panel = document.getElementById("selectedUnitPanel");
        const apartment = getApartment(reservationState.selectedApartmentId);
        if (!apartment) {
          panel.innerHTML = `<div class="selected-unit-empty">اختر شقة من خريطة المبنى لعرض التفاصيل والتحكم.</div>`;
          return;
        }

        const client = getClientForApartment(apartment.id);
        panel.innerHTML = `
        <h3>${escapeHTML(apartment.unitCode)} · نوع ${escapeHTML(apartment.apartmentType)}</h3>
        <p>${toArabicNumber(apartment.area)} م² · ${escapeHTML(apartment.directionAr)} · ${escapeHTML(apartment.directionEn)}</p>
        <div class="detail-list">
          <div class="detail-item">
            <span>حالة الشقة</span>
            <strong>${escapeHTML(translateStatus(apartment.status, "apartment"))}</strong>
          </div>
          <div class="detail-item">
            <span>العميل المخصص</span>
            <strong>${client ? escapeHTML(client.name) : "لا يوجد عميل مخصص"}</strong>
          </div>
          <div class="detail-item">
            <span>السعر الإجمالي</span>
            <strong>${formatMoneyAr(apartment.price)}</strong>
          </div>
          <div class="detail-item">
            <span>حالة الدفع</span>
            <strong>${client ? escapeHTML(translateStatus(client.paymentStatus, "payment")) : "لا يوجد"}</strong>
          </div>
        </div>

        <form class="management-form" id="apartmentEditForm" data-apartment-id="${apartment.id}">
          <div class="form-grid">
            <div class="form-field">
              <label for="editApartmentPrice">تعديل سعر الشقة</label>
              <input id="editApartmentPrice" type="number" min="0" step="1000" value="${apartment.price}" />
            </div>
            <div class="form-field">
              <label for="editApartmentStatus">تعديل حالة الشقة</label>
              <select id="editApartmentStatus">
                ${["Available", "Reserved", "Sold", "Pending Payment"].map((status) => `<option value="${status}" ${apartment.status === status ? "selected" : ""}>${translateStatus(status, "apartment")}</option>`).join("")}
              </select>
            </div>
            <div class="form-field full">
              <label for="editApartmentNotes">ملاحظات الشقة</label>
              <textarea id="editApartmentNotes">${escapeHTML(apartment.notes || "")}</textarea>
            </div>
          </div>
          <button class="btn primary" type="submit">حفظ تعديلات الشقة</button>
        </form>

        ${
          client
            ? `
          <article class="premium-card" style="margin-top:14px">
            <h4>ملخص دفع العميل</h4>
            ${ProgressBar(client.paymentProgress)}
            <div class="detail-list">
              <div class="detail-item"><span>المدفوع</span><strong>${formatMoneyAr(client.paidAmount)}</strong></div>
              <div class="detail-item"><span>المتبقي</span><strong>${formatMoneyAr(client.remainingAmount)}</strong></div>
            </div>
            <div class="payment-admin-list">
              ${(client.payments || [])
                .map(
                  (payment) => `
                <div class="payment-row-card">
                  <strong>${formatMoneyAr(payment.amount)}</strong>
                  <span>${formatDate(payment.date)} · ${escapeHTML(translateStatus(payment.method, "method"))} · ${escapeHTML(payment.reference || "بدون مرجع")}</span>
                  ${StatusBadge(payment.status, "paymentRecord")}
                  <div class="row-actions">
                    <button class="small-action" type="button" data-payment-action="edit" data-client-id="${client.id}" data-payment-id="${payment.id}">تعديل</button>
                    <button class="small-action" type="button" data-payment-action="receipt" data-client-id="${client.id}" data-payment-id="${payment.id}">تحميل إيصال الدفع</button>
                    <button class="small-action danger-action" type="button" data-payment-action="delete" data-client-id="${client.id}" data-payment-id="${payment.id}">حذف</button>
                  </div>
                </div>
              `,
                )
                .join("")}
            </div>
            ${
              (client.installments || []).length
                ? `
              <h4 style="margin-top:16px">جدول الأقساط</h4>
              <div class="payment-admin-list">
                ${client.installments
                  .map(
                    (item) => `
                  <div class="payment-row-card">
                    <strong>القسط ${toArabicNumber(item.installmentNumber)}</strong>
                    <span>${formatDate(item.dueDate)} · ${formatMoneyAr(item.amount)} · المتبقي ${formatMoneyAr(item.remainingAmount)}</span>
                    <span class="status-badge status-${slugStatus(item.status)}">${escapeHTML(installmentStatusAr[item.status] || item.status)}</span>
                  </div>
                `,
                  )
                  .join("")}
              </div>
            `
                : ""
            }
          </article>
        `
            : ""
        }
      `;
      }

      function populateAdminSelects() {
        const clientOptions = reservationState.clients
          .map((client) => {
            const apartment = getApartment(client.apartmentId);
            return `<option value="${client.id}">${escapeHTML(client.name)} · ${escapeHTML(client.code)}${apartment ? ` · ${escapeHTML(apartment.unitCode)}` : ""}</option>`;
          })
          .join("");

        const apartmentOptions = reservationState.apartments
          .map((apartment) => {
            const client = getClientForApartment(apartment.id);
            const label = `${apartment.unitCode} · الدور ${apartment.floorNumber} · ${translateStatus(apartment.status, "apartment")}${client ? ` · ${client.name}` : ""}`;
            return `<option value="${apartment.id}">${escapeHTML(label)}</option>`;
          })
          .join("");

        ["paymentClientSelect", "assignmentClientSelect", "installmentClientSelect"].forEach((id) => {
          const select = document.getElementById(id);
          if (select) select.innerHTML = clientOptions;
        });

        ["assignmentApartmentSelect", "newClientUnit"].forEach((id) => {
          const select = document.getElementById(id);
          if (select) select.innerHTML = apartmentOptions;
        });
      }

      function renderAdminDashboard() {
        syncReservationData();
        renderAdminOverview();
        renderAdminAlerts();
        document.getElementById("buildingMap").innerHTML =
          BuildingAvailabilityMap();
        document.getElementById("clientTableBody").innerHTML = ClientTable();
        renderAuditLogs();
        populateAdminSelects();
        populateSettingsForm();
        renderSelectedUnitPanel();
      }

      function renderAuditLogs() {
        const target = document.getElementById("auditLogTableBody");
        if (!target) return;
        if (!reservationState.auditLogs.length) {
          target.innerHTML = `<tr><td colspan="5"><div class="empty-state">لا توجد إجراءات إدارية مسجلة حتى الآن.</div></td></tr>`;
          return;
        }
        target.innerHTML = reservationState.auditLogs
          .slice(0, 12)
          .map(
            (log) => `
          <tr>
            <td>${escapeHTML(log.admin_name || log.adminName || "النظام")}</td>
            <td>${escapeHTML(log.action_type || log.actionType || "-")}</td>
            <td>${escapeHTML(log.entity_type || log.entityType || "-")}</td>
            <td>${escapeHTML(log.description || "-")}</td>
            <td>${formatDate(log.created_at || log.createdAt)}</td>
          </tr>
        `,
          )
          .join("");
      }

      function populateSettingsForm() {
        const settings = reservationState.settings || {};
        const fields = {
          settingOfficeName: settings.office_name,
          settingOfficePhone: settings.office_phone,
          settingWhatsapp: settings.whatsapp_number,
          settingOfficeAddress: settings.office_address,
          settingCurrency: settings.currency,
          settingReceiptPrefix: settings.receipt_prefix,
          settingFooter: settings.statement_footer,
        };
        Object.entries(fields).forEach(([id, value]) => {
          const input = document.getElementById(id);
          if (input && document.activeElement !== input) input.value = value || "";
        });
      }

      function ClientCodeAccess() {
        return document.getElementById("clientCodeForm");
      }

      function AdminDashboard() {
        return renderAdminDashboard();
      }

      function SearchAndFilters() {
        return {
          searchTerm: reservationState.searchTerm,
          activeFilter: reservationState.activeFilter,
        };
      }

      function AddPaymentForm() {
        return document.getElementById("paymentForm");
      }

      function ApartmentAssignmentForm() {
        return document.getElementById("assignmentForm");
      }

      function showAdminWarning(message, type = "warning") {
        const warning = document.getElementById("adminWarning");
        warning.textContent = message;
        warning.classList.add("show");
        warning.classList.toggle("access-error", type === "error");
        window.clearTimeout(showAdminWarning.timer);
        showAdminWarning.timer = window.setTimeout(() => {
          warning.classList.remove("show", "access-error");
        }, 5000);
      }

      function switchSidePanel(panelName) {
        document.querySelectorAll("[data-portal-tab]").forEach((button) => {
          button.classList.toggle(
            "active",
            button.dataset.portalTab === panelName,
          );
        });
        document
          .querySelectorAll(".portal-panel")
          .forEach((panel) => panel.classList.remove("active"));
        document
          .getElementById(`${panelName}Panel`)
          ?.classList.add("active");
      }

      function resetPaymentForm() {
        document.getElementById("paymentForm").reset();
        document.getElementById("editingPaymentId").value = "";
        document.getElementById("paymentSubmitButton").textContent =
          "حفظ الدفعة";
        document.getElementById("paymentDate").value = new Date()
          .toISOString()
          .slice(0, 10);
      }

      function resetClientForm() {
        document.getElementById("addClientForm").reset();
        document.getElementById("editingClientId").value = "";
        document.getElementById("clientSubmitButton").textContent =
          "إنشاء كود وإضافة العميل";
      }

      function handleSafeAssignment(clientId, apartmentId) {
        const client = getClientById(clientId);
        const apartment = getApartment(apartmentId);
        const existingClient = getClientForApartment(apartmentId);

        if (!client || !apartment) {
          showAdminWarning(
            "يرجى اختيار عميل وشقة بشكل صحيح.",
            "error",
          );
          return false;
        }

        if (existingClient && existingClient.id !== client.id) {
          showAdminWarning(
            "هذه الشقة محجوزة بالفعل لعميل آخر.",
            "error",
          );
          return false;
        }

        if (
          ["Reserved", "Sold", "Pending Payment"].includes(apartment.status) &&
          apartment.assignedClientId !== client.id &&
          !existingClient
        ) {
          showAdminWarning(
            "هذه الشقة محددة كمحجوزة أو مباعة. يرجى مراجعة حالتها قبل التخصيص.",
            "error",
          );
          return false;
        }

        client.apartmentId = apartment.id;
        client.totalAmount = apartment.price;
        reservationState.selectedApartmentId = apartment.id;
        showAdminWarning(
          `تم تخصيص الشقة ${apartment.unitCode} للعميل ${client.name}.`,
        );
        renderAdminDashboard();
        return true;
      }

      function generatePrivateCode(apartment) {
        const randomPart = Math.random().toString(36).slice(2, 7).toUpperCase();
        return `RES-${apartment?.unitCode || "UNIT"}-${randomPart}`;
      }

      function initReservationSystem() {
        syncReservationData();

        document.querySelectorAll("[data-portal-tab]").forEach((button) => {
          button.addEventListener("click", () => {
            const target = button.dataset.portalTab;
            document
              .querySelectorAll("[data-portal-tab]")
              .forEach((tabButton) => {
                const isActive = tabButton.dataset.portalTab === target;
                tabButton.classList.toggle("active", isActive);
                tabButton.setAttribute("aria-selected", String(isActive));
              });
            document
              .querySelectorAll(".portal-panel")
              .forEach((panel) => panel.classList.remove("active"));
            document
              .getElementById(`${target}PortalPanel`)
              .classList.add("active");
          });
        });

        document
          .getElementById("clientCodeForm")
          .addEventListener("submit", (event) => {
            event.preventDefault();
            const codeInput = document.getElementById("reservationCode");
            const button = document.getElementById("clientCodeButton");
            const error = document.getElementById("clientCodeMessage");
            const success = document.getElementById("clientSuccessMessage");
            const code = codeInput.value.trim();

            error.classList.remove("show");
            success.classList.remove("show");
            document.getElementById("clientDashboard").classList.remove("show");

            if (!code || code.trim().length < 8) {
              error.textContent = "كود الحجز غير صالح. يجب أن يكون 8 أحرف على الأقل.";
              error.classList.add("show");
              codeInput.focus();
              return;
            }

            // Show loading state
            button.textContent = "جاري البحث...";
            button.disabled = true;

            window.setTimeout(async () => {
              try {
                const client = await findClientByCode(code);
                button.textContent = "عرض بيانات الحجز";
                button.disabled = false;

                if (!client) {
                  error.textContent =
                    "لم نتمكن من التحقق من كود الحجز. يرجى التأكد من الكود والمحاولة مرة أخرى أو التواصل مع المكتب.";
                  error.classList.add("show");
                  return;
                }

                calculateClientFinancials(client);
                success.textContent = "تم التحقق من كود الحجز بنجاح.";
                success.classList.add("show");
                renderClientDashboard(client);
              } catch (apiError) {
                button.textContent = "عرض بيانات الحجز";
                button.disabled = false;
                error.textContent = apiError.message || 
                  "حدث خطأ في الاتصال بالخادم. يرجى المحاولة مرة أخرى.";
                error.classList.add("show");
              }
            }, 800);
          });

        document
          .getElementById("clientDashboard")
          .addEventListener("click", (event) => {
            const button = event.target.closest("[data-statement-client]");
            if (!button) return;
            downloadReservationStatement(button.dataset.statementClient);
          });

        document
          .getElementById("adminPortalTab")
          .addEventListener("click", () => {
            switchSidePanel("admin");
          });

        document
          .getElementById("updatesAdminTab")
          ?.addEventListener("click", () => {
            switchSidePanel("updates-admin");
          });

        document
          .getElementById("adminCodeForm")
          .addEventListener("submit", (event) => {
            event.preventDefault();
            const emailInput = document.getElementById("adminEmail");
            const codeInput = document.getElementById("adminCode");
            const error = document.getElementById("adminCodeMessage");
            const button = document.getElementById("adminCodeButton");

            error.classList.remove("show");
            if (!emailInput.value.trim() || !codeInput.value.trim()) {
              error.textContent = "يرجى إدخال البريد الإلكتروني وكلمة المرور.";
              error.classList.add("show");
              (!emailInput.value.trim() ? emailInput : codeInput).focus();
              return;
            }

            button.textContent = "جاري تسجيل الدخول...";
            button.disabled = true;

            window.setTimeout(async () => {
              try {
                await apiFetch("/api/admin/login", {
                  method: "POST",
                  body: JSON.stringify({
                    email: emailInput.value.trim(),
                    password: codeInput.value,
                  }),
                });
                reservationState.adminUnlocked = true;
                document.getElementById("adminGate").style.display = "none";
                document.getElementById("adminDashboard").classList.add("show");
                await loadAdminData();
              } catch (apiError) {
                error.textContent =
                  apiError.message || "تعذر تسجيل الدخول. يرجى مراجعة البيانات.";
                error.classList.add("show");
              } finally {
                button.textContent = "تسجيل الدخول";
                button.disabled = false;
              }
            }, 420);
          });

        document
          .getElementById("refreshAdminButton")
          .addEventListener("click", () => loadAdminData().catch((error) => showAdminWarning(error.message, "error")));
        document
          .getElementById("adminLogoutButton")
          .addEventListener("click", async () => {
            await apiFetch("/api/admin/logout", { method: "POST" }).catch(() => null);
            reservationState.adminUnlocked = false;
            document.getElementById("adminDashboard").classList.remove("show");
            document.getElementById("adminGate").style.display = "";
          });
        document
          .getElementById("adminSearch")
          .addEventListener("input", (event) => {
            reservationState.searchTerm = event.target.value;
            renderAdminDashboard();
          });
        document
          .getElementById("adminFilter")
          .addEventListener("change", (event) => {
            reservationState.activeFilter = event.target.value;
            renderAdminDashboard();
          });

        document
          .getElementById("buildingMap")
          .addEventListener("click", (event) => {
            const card = event.target.closest("[data-apartment-id]");
            if (!card) return;
            reservationState.selectedApartmentId = card.dataset.apartmentId;
            renderAdminDashboard();
          });

        document
          .getElementById("clientTableBody")
          .addEventListener("click", (event) => {
            const action = event.target.closest("[data-client-action]");
            if (!action) return;
            const client = getClientById(action.dataset.clientId);
            if (!client) return;
            reservationState.selectedApartmentId = client.apartmentId;
            renderAdminDashboard();

            if (action.dataset.clientAction === "edit") {
              switchSidePanel("client");
              document.getElementById("editingClientId").value = client.id;
              document.getElementById("newClientName").value = client.name;
              document.getElementById("newClientPhone").value =
                client.phone || "";
              document.getElementById("newClientUnit").value =
                client.apartmentId || "";
              document.getElementById("newClientStatus").value =
                client.reservationStatus;
              document.getElementById("newClientNotes").value =
                client.officeNotes || "";
              document.getElementById("clientSubmitButton").textContent =
                "حفظ بيانات العميل";
            }
          });

        document.querySelectorAll("[data-side-tab]").forEach((button) => {
          button.addEventListener("click", () =>
            switchSidePanel(button.dataset.sideTab),
          );
        });

        document
          .getElementById("addClientForm")
          .addEventListener("submit", async (event) => {
            event.preventDefault();
            const apartment = getApartment(
              document.getElementById("newClientUnit").value,
            );
            const existingClient = apartment
              ? getClientForApartment(apartment.id)
              : null;
            const editingClientId =
              document.getElementById("editingClientId").value;
            const editingClient = editingClientId
              ? getClientById(editingClientId)
              : null;

            if (!apartment) {
              showAdminWarning(
                "يرجى اختيار شقة قبل حفظ بيانات العميل.",
                "error",
              );
              return;
            }

            if (existingClient && existingClient.id !== editingClientId) {
              showAdminWarning(
                "لا يمكن حجز نفس الشقة لأكثر من عميل.",
                "error",
              );
              return;
            }

            const name = document.getElementById("newClientName").value.trim();
            if (!name) {
              showAdminWarning("اسم العميل مطلوب.", "error");
              return;
            }

            const payload = {
              full_name: name,
              phone: document.getElementById("newClientPhone").value.trim(),
              apartment_id: apartment.id,
              reservation_status: document.getElementById("newClientStatus").value,
              expected_delivery_date: project.deliveryDate.slice(0, 10),
              office_notes: document.getElementById("newClientNotes").value.trim(),
              total_amount: apartment.price,
            };

            try {
              if (editingClient) {
                await apiFetch(`/api/admin/clients/${editingClient.id}`, {
                  method: "PATCH",
                  body: JSON.stringify(payload),
                });
                showAdminWarning("تم تعديل بيانات العميل بنجاح.");
              } else {
                const response = await apiFetch("/api/admin/clients", {
                  method: "POST",
                  body: JSON.stringify(payload),
                });
                showAdminWarning(`تم إضافة العميل. كود الحجز: ${response.client.code}`);
              }
              reservationState.selectedApartmentId = apartment.id;
              resetClientForm();
              await loadAdminData();
            } catch (error) {
              showAdminWarning(error.message, "error");
            }
          });

        document
          .getElementById("assignmentForm")
          .addEventListener("submit", async (event) => {
            event.preventDefault();
            try {
              const apartmentId = document.getElementById("assignmentApartmentSelect").value;
              await apiFetch("/api/admin/assign-apartment", {
                method: "POST",
                body: JSON.stringify({
                  client_id: document.getElementById("assignmentClientSelect").value,
                  apartment_id: apartmentId,
                }),
              });
              reservationState.selectedApartmentId = apartmentId;
              showAdminWarning("تم تخصيص الشقة بنجاح.");
              await loadAdminData();
            } catch (error) {
              showAdminWarning(error.message, "error");
            }
          });

        document
          .getElementById("installmentForm")
          .addEventListener("submit", async (event) => {
            event.preventDefault();
            const clientId = document.getElementById("installmentClientSelect").value;
            const amount = Number(document.getElementById("installmentAmount").value);
            const dueDate = document.getElementById("installmentDueDate").value;
            if (!clientId || !dueDate || amount <= 0) {
              showAdminWarning("يرجى اختيار العميل وتاريخ الاستحقاق وقيمة القسط.", "error");
              return;
            }
            try {
              await apiFetch("/api/admin/installments", {
                method: "POST",
                body: JSON.stringify({
                  client_id: clientId,
                  installment_number: Number(document.getElementById("installmentNumber").value || 1),
                  due_date: dueDate,
                  amount,
                  paid_amount: Number(document.getElementById("installmentPaidAmount").value || 0),
                  notes: document.getElementById("installmentNotes").value.trim(),
                }),
              });
              showAdminWarning("تم حفظ القسط وتحديث جدول السداد.");
              document.getElementById("installmentForm").reset();
              document.getElementById("installmentNumber").value = 1;
              document.getElementById("installmentPaidAmount").value = 0;
              await loadAdminData();
            } catch (error) {
              showAdminWarning(error.message, "error");
            }
          });

        document
          .getElementById("settingsForm")
          .addEventListener("submit", async (event) => {
            event.preventDefault();
            try {
              await apiFetch("/api/admin/settings", {
                method: "PATCH",
                body: JSON.stringify({
                  office_name: document.getElementById("settingOfficeName").value.trim(),
                  office_phone: document.getElementById("settingOfficePhone").value.trim(),
                  whatsapp_number: document.getElementById("settingWhatsapp").value.trim(),
                  office_address: document.getElementById("settingOfficeAddress").value.trim(),
                  currency: document.getElementById("settingCurrency").value.trim() || "EGP",
                  receipt_prefix: document.getElementById("settingReceiptPrefix").value.trim() || "RCPT",
                  statement_footer: document.getElementById("settingFooter").value.trim(),
                }),
              });
              showAdminWarning("تم حفظ إعدادات النظام.");
              await loadAdminData();
            } catch (error) {
              showAdminWarning(error.message, "error");
            }
          });

        document
          .getElementById("paymentForm")
          .addEventListener("submit", async (event) => {
            event.preventDefault();
            const client = getClientById(
              document.getElementById("paymentClientSelect").value,
            );
            if (!client) {
              showAdminWarning(
                "يرجى اختيار عميل صحيح قبل إضافة الدفعة.",
                "error",
              );
              return;
            }

            const editingPaymentId = document.getElementById("editingPaymentId").value;
            const paymentPayload = {
              payment_date: document.getElementById("paymentDate").value,
              amount: Number(document.getElementById("paymentAmount").value),
              payment_method: document.getElementById("paymentMethod").value,
              payment_status: document.getElementById("paymentStatus").value,
              reference_number: document
                .getElementById("paymentReference")
                .value.trim(),
              notes: document.getElementById("paymentNotes").value.trim(),
              client_id: client.id,
            };

            if (!paymentPayload.payment_date || paymentPayload.amount <= 0) {
              showAdminWarning(
                "تاريخ الدفع والمبلغ مطلوبان.",
                "error",
              );
              return;
            }

            try {
              if (editingPaymentId) {
                await apiFetch(`/api/admin/payments/${editingPaymentId}`, {
                  method: "PATCH",
                  body: JSON.stringify(paymentPayload),
                });
                showAdminWarning("تم تعديل الدفعة وإعادة حساب الإجماليات.");
              } else {
                await apiFetch("/api/admin/payments", {
                  method: "POST",
                  body: JSON.stringify(paymentPayload),
                });
                showAdminWarning("تم إضافة الدفعة وإعادة حساب الإجماليات.");
              }
              reservationState.selectedApartmentId = client.apartmentId;
              resetPaymentForm();
              await loadAdminData();
            } catch (error) {
              showAdminWarning(error.message, "error");
            }
          });

        document
          .getElementById("selectedUnitPanel")
          .addEventListener("submit", async (event) => {
            if (event.target.id !== "apartmentEditForm") return;
            event.preventDefault();
            const apartment = getApartment(event.target.dataset.apartmentId);
            if (!apartment) return;

            const status = document.getElementById("editApartmentStatus").value;
            const assignedClient = getClientForApartment(apartment.id);
            if (status === "Available" && assignedClient) {
              showAdminWarning(
                "هذه الشقة مرتبطة بعميل نشط. يرجى إلغاء أو نقل الحجز قبل جعلها متاحة.",
                "error",
              );
              return;
            }

            try {
              await apiFetch(`/api/admin/apartments/${apartment.id}`, {
                method: "PATCH",
                body: JSON.stringify({
                  price: Number(document.getElementById("editApartmentPrice").value || 0),
                  status,
                  notes: document.getElementById("editApartmentNotes").value.trim(),
                }),
              });
              showAdminWarning("تم تعديل بيانات الشقة.");
              await loadAdminData();
            } catch (error) {
              showAdminWarning(error.message, "error");
            }
          });

        document
          .getElementById("selectedUnitPanel")
          .addEventListener("click", async (event) => {
            const paymentAction = event.target.closest("[data-payment-action]");
            if (!paymentAction) return;

            const client = getClientById(paymentAction.dataset.clientId);
            const payment = client?.payments.find(
              (item) => item.id === paymentAction.dataset.paymentId,
            );
            if (!client || !payment) return;

            if (paymentAction.dataset.paymentAction === "delete") {
              if (!confirm("لا يمكن حذف هذه الدفعة بدون تأكيد. هل تريد المتابعة؟")) return;
              try {
                await apiFetch(`/api/admin/payments/${payment.id}?confirm=true`, {
                  method: "DELETE",
                });
                showAdminWarning("تم حذف الدفعة وإعادة حساب الإجماليات.");
                await loadAdminData();
              } catch (error) {
                showAdminWarning(error.message, "error");
              }
              return;
            }

            if (paymentAction.dataset.paymentAction === "receipt") {
              try {
                const response = await apiFetch("/api/admin/receipts/generate", {
                  method: "POST",
                  body: JSON.stringify({ payment_id: payment.id }),
                });
                window.open(response.url, "_blank", "noopener");
              } catch (error) {
                showAdminWarning(error.message, "error");
              }
              return;
            }

            switchSidePanel("payment");
            document.getElementById("paymentClientSelect").value = client.id;
            document.getElementById("editingPaymentId").value = payment.id;
            document.getElementById("paymentAmount").value = payment.amount;
            document.getElementById("paymentMethod").value = payment.method;
            document.getElementById("paymentStatus").value = payment.status;
            document.getElementById("paymentDate").value = payment.date;
            document.getElementById("paymentReference").value =
              payment.reference || "";
            document.getElementById("paymentNotes").value = payment.notes || "";
            document.getElementById("paymentSubmitButton").textContent =
              "تعديل الدفعة";
          });

        resetPaymentForm();
        restoreAdminSession();
      }

      function hydrateProjectData() {
        document.querySelectorAll("[data-project-name]").forEach((node) => {
          node.textContent = project.name;
        });
        document.querySelectorAll("[data-project-location]").forEach((node) => {
          node.textContent = project.location;
        });
        document.querySelector("[data-current-phase]").textContent =
          project.currentPhase;

        const delivery = new Date(project.deliveryDate);
        document.querySelector("[data-delivery-label]").textContent =
          dateFormatter.format(delivery);
        document.querySelector("[data-delivery-short]").textContent =
          monthFormatter.format(delivery);
      }

      function renderTimeline() {
        const grid = document.getElementById("timelineGrid");
        grid.innerHTML = stages
          .map(
            (stage, index) => `
        <article class="stage ${stage.className} reveal" style="--delay:${index * 70}ms">
          <span class="stage-status">${stage.status}</span>
          <h3>${stage.title}</h3>
          <p>${stage.description}</p>
          <div class="stage-date">
            <span>البداية: ${formatDate(stage.start)}</span>
            <span>النهاية: ${formatDate(stage.end)}</span>
          </div>
          <div class="stage-progress">
            <span>${formatPercent(stage.progress)}</span>
            <div class="progress-track" aria-label="نسبة اكتمال ${stage.title}">
              <div class="progress-fill" data-progress="${stage.progress}"></div>
            </div>
          </div>
        </article>
      `,
          )
          .join("");
      }

      async function renderUpdates() {
        const grid = document.getElementById("updatesGrid");
        
        try {
          const response = await apiFetch("/api/project-updates/published");
          const updates = response || [];
          
          if (updates.length === 0) {
            // Show empty state
            grid.innerHTML = `
              <div class="empty-state" style="text-align: center; padding: 60px 20px; color: var(--gold-2);">
                <svg width="64" height="64" fill="rgba(156, 111, 56, 0.3)" viewBox="0 0 24 24" style="margin-bottom: 16px;">
                  <path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/>
                </svg>
                <h3 style="margin: 0 0 8px; font-size: 1.3rem; color: var(--ink);">لا توجد تحديثات منشورة حاليًا.</h3>
                <p style="margin: 0; color: rgba(248, 243, 232, 0.68); font-size: 0.95rem;">سيتم عرض تحديثات المشروع هنا فور نشرها من الإدارة.</p>
              </div>
            `;
            return;
          }
          
          grid.innerHTML = updates
            .map(
              (item, index) => `
            <article class="update-card reveal" style="--delay:${index * 70}ms">
              ${item.media_type === 'video' ? 
                `<div style="position: relative; width: 100%; height: 200px; border-radius: 8px; overflow: hidden; cursor: pointer;" onclick="openVideoModal('${item.media_url}')">
                  <img src="${item.thumbnail_url || '/media/facade.jpg'}" alt="${item.title}" style="width: 100%; height: 100%; object-fit: cover;">
                  <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 48px; height: 48px; background: rgba(0,0,0,0.7); border: 2px solid rgba(217, 181, 101, 0.5); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <svg width="20" height="20" fill="white" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                  <div style="position: absolute; top: 10px; right: 10px; background: rgba(0,0,0,0.8); color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: bold;">
                    فيديو
                  </div>
                </div>` :
                `<div style="position: relative; width: 100%; height: 200px; border-radius: 8px; overflow: hidden; cursor: pointer;" onclick="openImageModal('${item.media_url}')">
                  <img src="${item.media_url}" alt="${item.title}" style="width: 100%; height: 100%; object-fit: cover;">
                  <div style="position: absolute; top: 10px; right: 10px; background: rgba(0,0,0,0.8); color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: bold;">
                    صورة
                  </div>
                </div>`
              }
              <div class="update-content">
                <time datetime="${item.update_date}">${formatDate(item.update_date)}</time>
                <h3>${item.title}</h3>
                <p>${item.description}</p>
                <div style="margin-top: 12px;">
                  <span style="display: inline-block; background: rgba(217, 181, 101, 0.15); color: var(--ink); padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 800;">
                    ${getStageLabel(item.stage)}
                  </span>
                </div>
              </div>
            </article>
          `,
            )
            .join("");
        } catch (error) {
          console.error("Failed to load updates:", error);
          grid.innerHTML = `
            <div style="text-align: center; padding: 60px 20px; color: var(--gold-2);">
              <h3>فشل تحميل التحديثات</h3>
              <p>يرجى المحاولة مرة أخرى.</p>
            </div>
          `;
        }
      }

      function renderGallery() {
        const grid = document.getElementById("galleryGrid");
        grid.innerHTML = galleryItems
          .map(
            (item, index) => {
              const isPlan = item.category === "apartment-plan";
              const isVideo = !!item.video;
              let extraClass = item.featured ? "featured" : "";
              if (isPlan) extraClass += " plan-card";
              if (isVideo) extraClass += " video-card";

              let media;
              if (isVideo) {
                media = `<img src="${item.poster || 'media/facade.jpg'}" alt="${item.title}" loading="lazy" />
                  <div class="video-play-overlay">
                    <svg width="28" height="28" fill="white" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  </div>`;
              } else {
                media = `<img src="${item.image}" alt="${item.title}" loading="lazy" />`;
              }

              return `
        <article class="gallery-card ${extraClass} reveal" data-category="${item.category}" ${isVideo ? `data-video-src="${item.video}"` : ''} style="--delay:${index * 70}ms">
          ${media}
          <div class="gallery-caption">
            <span class="gallery-label">${item.label}</span>
            <h3>${item.title}</h3>
            <p>${item.description}</p>
          </div>
        </article>`;
            })
          .join("");
      }

      function renderStats() {
        const salePercent = Math.round(
          (project.soldUnits / project.totalUnits) * 100,
        );
        const remainingUnits = project.totalUnits - project.soldUnits;
        const stats = [
          {
            label: "عدد الأدوار",
            value: `${toArabicNumber(project.floors)} أدوار`,
            note: "توزيع سكني هادئ ومنظم",
          },
          {
            label: "عدد الشقق الكلي",
            value: `${toArabicNumber(project.totalUnits)} شقة`,
            note: `${toArabicNumber(remainingUnits)} شقة متاحة حالياً`,
          },
          {
            label: "المساحات المتاحة",
            value: project.spaces,
            note: "مساحات مناسبة للسكن والاستثمار",
          },
          {
            label: "نسبة البيع",
            value: formatPercent(salePercent),
            note: `${toArabicNumber(project.soldUnits)} شقة مبيعة من أصل ${toArabicNumber(project.totalUnits)}`,
          },
        ];

        document.getElementById("salePercentBadge").textContent =
          formatPercent(salePercent);
        document.getElementById("statsGrid").innerHTML = stats
          .map(
            (item, index) => `
        <article class="stat-card reveal" style="--delay:${index * 70}ms">
          <span>${item.label}</span>
          <strong>${item.value}</strong>
          <small>${item.note}</small>
        </article>
      `,
          )
          .join("");
      }

      function updateCountdown() {
        const target = new Date(project.deliveryDate).getTime();
        const now = Date.now();
        const distance = Math.max(0, target - now);
        const day = 1000 * 60 * 60 * 24;
        const hour = 1000 * 60 * 60;
        const minute = 1000 * 60;

        const days = Math.floor(distance / day);
        const hours = Math.floor((distance % day) / hour);
        const minutes = Math.floor((distance % hour) / minute);
        const seconds = Math.floor((distance % minute) / 1000);

        document.getElementById("days").textContent = toArabicNumber(days);
        document.getElementById("hours").textContent = toArabicNumber(hours);
        document.getElementById("minutes").textContent =
          toArabicNumber(minutes);
        document.getElementById("seconds").textContent =
          toArabicNumber(seconds);
      }

      function setProgressBars() {
        const overallProgress = Math.round(
          stages.reduce((sum, stage) => sum + stage.progress, 0) /
            stages.length,
        );
        const overallFill = document.getElementById("overallFill");
        document.getElementById("overallPercent").textContent =
          formatPercent(overallProgress);
        overallFill.dataset.progress = overallProgress;

        document.querySelectorAll(".progress-fill").forEach((bar) => {
          const value = Number(bar.dataset.progress || 0);
          window.setTimeout(() => {
            bar.style.width = `${value}%`;
          }, 240);
        });
      }

      function enableGalleryFilters() {
        const buttons = document.querySelectorAll(".filter-btn");

        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            const filter = button.dataset.filter;
            const cards = document.querySelectorAll(".gallery-card");

            buttons.forEach((item) => item.classList.remove("active"));
            button.classList.add("active");

            cards.forEach((card) => {
              const shouldShow =
                filter === "all" || card.dataset.category === filter;
              card.hidden = !shouldShow;
            });
          });
        });

        // Video card click handler
        document.getElementById("galleryGrid").addEventListener("click", (event) => {
          const videoCard = event.target.closest(".video-card[data-video-src]");
          if (!videoCard) return;
          openVideoModal(videoCard.dataset.videoSrc);
        });
      }

      function openVideoModal(videoSrc) {
        const overlay = document.getElementById("videoModal");
        const video = document.getElementById("modalVideo");
        video.src = videoSrc;
        overlay.classList.add("show");
        video.play().catch(() => {});
      }

      function openImageModal(imageSrc) {
        const overlay = document.createElement("div");
        overlay.className = "image-modal-overlay show";
        overlay.innerHTML = `
          <div class="image-modal-content">
            <button class="image-modal-close" onclick="this.parentElement.parentElement.remove()">&times;</button>
            <img src="${imageSrc}" style="max-width: 90vw; max-height: 90vh; object-fit: contain;" alt="صورة التحديث">
          </div>
        `;
        overlay.onclick = function(e) {
          if (e.target === overlay) overlay.remove();
        };
        document.body.appendChild(overlay);
      }

      function closeVideoModal() {
        const overlay = document.getElementById("videoModal");
        const video = document.getElementById("modalVideo");
        video.pause();
        video.src = "";
        overlay.classList.remove("show");
      }

      // Project Updates Management
      let editingUpdateId = null;

      function showUpdateForm(updateId = null) {
        const modal = document.getElementById("updateFormModal");
        const title = document.getElementById("updateFormTitle");
        
        if (updateId) {
          title.textContent = "تعديل التحديث";
          loadUpdateForEdit(updateId);
        } else {
          title.textContent = "إضافة تحديث جديد";
          resetUpdateForm();
        }
        
        modal.style.display = "flex";
        editingUpdateId = updateId;
      }

      function hideUpdateForm() {
        document.getElementById("updateFormModal").style.display = "none";
        resetUpdateForm();
        editingUpdateId = null;
      }

      function resetUpdateForm() {
        document.getElementById("updateForm").reset();
        document.getElementById("imagePreview").innerHTML = "";
        document.getElementById("videoPreview").innerHTML = "";
        document.getElementById("imageField").style.display = "none";
        document.getElementById("videoField").style.display = "none";
      }

      function toggleMediaFields() {
        const mediaType = document.getElementById("updateMediaType").value;
        const imageField = document.getElementById("imageField");
        const videoField = document.getElementById("videoField");
        
        if (mediaType === "image") {
          imageField.style.display = "block";
          videoField.style.display = "none";
        } else if (mediaType === "video") {
          imageField.style.display = "none";
          videoField.style.display = "block";
        } else {
          imageField.style.display = "none";
          videoField.style.display = "none";
        }
      }

      async function loadUpdatesTable() {
        try {
          const response = await apiFetch("/api/admin/project-updates");
          const updates = response || [];
          
          const tbody = document.getElementById("updatesTableBody");
          tbody.innerHTML = updates.map(update => `
            <tr>
              <td>${update.title}</td>
              <td>${getStageLabel(update.stage)}</td>
              <td>${update.update_date}</td>
              <td>${update.media_type === 'image' ? 'صورة' : 'فيديو'}</td>
              <td>
                <span class="status-badge ${update.status === 'published' ? 'status-available' : 'status-pending'}">
                  ${update.status === 'published' ? 'منشور' : 'مسودة'}
                </span>
              </td>
              <td>${update.display_order}</td>
              <td>
                <button class="btn secondary" onclick="showUpdateForm('${update.id}')">تعديل</button>
                ${update.status === 'published' ? 
                  `<button class="btn secondary" onclick="unpublishUpdate('${update.id}')">إلغاء النشر</button>` :
                  `<button class="btn primary" onclick="publishUpdate('${update.id}')">نشر</button>`
                }
                <button class="btn secondary" onclick="deleteUpdate('${update.id}')">حذف</button>
              </td>
            </tr>
          `).join("");
        } catch (error) {
          console.error("Failed to load updates:", error);
        }
      }

      async function loadUpdateForEdit(updateId) {
        try {
          const updates = await apiFetch("/api/admin/project-updates");
          const update = updates.find(u => u.id === updateId);
          
          if (update) {
            document.getElementById("updateTitle").value = update.title;
            document.getElementById("updateDate").value = update.update_date;
            document.getElementById("updateStage").value = update.stage;
            document.getElementById("updateDescription").value = update.description;
            document.getElementById("updateMediaType").value = update.media_type;
            document.getElementById("updateStatus").value = update.status;
            document.getElementById("updateOrder").value = update.display_order;
            
            toggleMediaFields();
          }
        } catch (error) {
          console.error("Failed to load update:", error);
        }
      }

      async function saveUpdate(event) {
        event.preventDefault();
        
        const formData = new FormData(event.target);
        const payload = {
          title: formData.get("title"),
          update_date: formData.get("update_date"),
          stage: formData.get("stage"),
          description: formData.get("description"),
          media_type: formData.get("media_type"),
          status: formData.get("status"),
          display_order: parseInt(formData.get("display_order")) || 0
        };

        // Handle file upload
        const imageFile = document.getElementById("updateImage").files[0];
        const videoFile = document.getElementById("updateVideo").files[0];
        
        if (imageFile || videoFile) {
          try {
            const uploadFormData = new FormData();
            uploadFormData.append("file", imageFile || videoFile);
            
            const uploadResponse = await apiFetch("/api/admin/uploads/project-update-media", {
              method: "POST",
              body: uploadFormData
            });
            
            if (uploadResponse.url) {
              payload.media_url = uploadResponse.url;
            }
          } catch (error) {
            console.error("Upload failed:", error);
            alert("فشل رفع الملف");
            return;
          }
        }

        try {
          if (editingUpdateId) {
            await apiFetch(`/api/admin/project-updates/${editingUpdateId}`, {
              method: "PATCH",
              body: JSON.stringify(payload)
            });
            alert("تم تعديل التحديث بنجاح");
          } else {
            await apiFetch("/api/admin/project-updates", {
              method: "POST",
              body: JSON.stringify(payload)
            });
            alert("تم إضافة التحديث بنجاح");
          }
          
          hideUpdateForm();
          loadUpdatesTable();
        } catch (error) {
          console.error("Save failed:", error);
          alert("فشل حفظ التحديث");
        }
      }

      async function publishUpdate(updateId) {
        if (!confirm("هل أنت متأكد من نشر هذا التحديث؟")) return;
        
        try {
          await apiFetch(`/api/admin/project-updates/${updateId}/publish`, {
            method: "POST"
          });
          alert("تم نشر التحديث بنجاح");
          loadUpdatesTable();
        } catch (error) {
          console.error("Publish failed:", error);
          alert("فشل نشر التحديث");
        }
      }

      async function unpublishUpdate(updateId) {
        if (!confirm("هل أنت متأكد من إلغاء نشر هذا التحديث؟")) return;
        
        try {
          await apiFetch(`/api/admin/project-updates/${updateId}/unpublish`, {
            method: "POST"
          });
          alert("تم إلغاء نشر التحديث بنجاح");
          loadUpdatesTable();
        } catch (error) {
          console.error("Unpublish failed:", error);
          alert("فشل إلغاء نشر التحديث");
        }
      }

      async function deleteUpdate(updateId) {
        if (!confirm("هل أنت متأكد من حذف هذا التحديث؟")) return;
        
        try {
          await apiFetch(`/api/admin/project-updates/${updateId}`, {
            method: "DELETE"
          });
          alert("تم حذف التحديث بنجاح");
          loadUpdatesTable();
        } catch (error) {
          console.error("Delete failed:", error);
          alert("فشل حذف التحديث");
        }
      }

      function getStageLabel(stage) {
        const stages = {
          'foundation': 'الأساسات',
          'concrete': 'أعمال الخرسانة',
          'walls': 'أعمال المباني',
          'finishing': 'التشطيبات',
          'exterior': 'الواجهة',
          'delivery': 'التسليم',
          'general': 'عام'
        };
        return stages[stage] || stage;
      }

      // Handle image/video preview
      document.getElementById("updateImage")?.addEventListener("change", function(e) {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            document.getElementById("imagePreview").innerHTML = 
              `<img src="${e.target.result}" style="max-width: 200px; max-height: 150px; border-radius: 4px;">`;
          };
          reader.readAsDataURL(file);
        }
      });

      document.getElementById("updateVideo")?.addEventListener("change", function(e) {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            document.getElementById("videoPreview").innerHTML = 
              `<video src="${e.target.result}" style="max-width: 200px; max-height: 150px; border-radius: 4px;" controls></video>`;
          };
          reader.readAsDataURL(file);
        }
      });

      function enableRevealAnimations() {
        const revealItems = document.querySelectorAll(".reveal");

        if (!("IntersectionObserver" in window)) {
          revealItems.forEach((item) => item.classList.add("visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 },
        );

        revealItems.forEach((item) => observer.observe(item));
      }

      function enableLeadForm() {
        const form = document.getElementById("leadForm");
        form.addEventListener("submit", (event) => {
          event.preventDefault();

          const formData = new FormData(form);
          const name = formData.get("name");
          const phone = formData.get("phone");
          const message = formData.get("message");
          const text = [
            `مرحباً، أنا ${name}.`,
            `رقمي: ${phone}.`,
            `رسالتي: ${message}`,
            `أرغب في تفاصيل ${project.name}.`,
          ].join("\n");

          window.open(
            `https://wa.me/${project.whatsappNumber}?text=${encodeURIComponent(text)}`,
            "_blank",
            "noopener",
          );
        });
      }

      function init() {
        hydrateProjectData();
        renderTimeline();
        renderUpdates();
        renderGallery();
        renderStats();
        initReservationSystem();
        enableGalleryFilters();
        enableLeadForm();
        enableRevealAnimations();
        updateCountdown();
        setProgressBars();
        window.setInterval(updateCountdown, 1000);
        
        // Load updates table if updates admin tab is active
        const updatesTab = document.getElementById("updatesAdminTab");
        if (updatesTab && updatesTab.classList.contains("active")) {
          loadUpdatesTable();
        }
      }

      init();
    </script>

    <!-- Video Modal -->
    <div class="video-modal-overlay" id="videoModal" onclick="if(event.target===this)closeVideoModal()">
      <div class="video-modal-content">
        <button class="video-modal-close" onclick="closeVideoModal()" aria-label="Close video">&times;</button>
        <video id="modalVideo" controls></video>
      </div>
    </div>
  </body>
</html>
