<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="متابعة حالة مشروع أرض عبدالجليل العقاري تحت الإنشاء، مراحل التنفيذ، التحديثات، الصور، وبيانات البيع."
    />
    <title>مشروع أرض عبدالجليل | متابعة الإنشاء</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa+Ink:wght@400;700&family=Cairo:wght@400;500;600;700;800;900&family=Tajawal:wght@400;500;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media = 'all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa+Ink:wght@400;700&family=Cairo:wght@400;500;600;700;800;900&family=Tajawal:wght@400;500;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <style>
      :root {
        --ink: #090908;
        --ink-2: #11100e;
        --charcoal: #191815;
        --ivory: #f8f3e8;
        --paper: #fffaf0;
        --muted: #bdb3a1;
        --gold: #d9b565;
        --gold-2: #f1d896;
        --bronze: #9c6f38;
        --copper: #b77942;
        --sage: #5f715d;
        --wine: #6e2b35;
        --blueprint: #293d4a;
        --blueprint-2: #5d7f85;
        --line: rgba(248, 243, 232, 0.16);
        --glass: rgba(16, 15, 13, 0.58);
        --glass-soft: rgba(255, 250, 240, 0.08);
        --shadow: 0 26px 80px rgba(0, 0, 0, 0.34);
        --radius: 8px;
        --container: min(1180px, calc(100% - 40px));
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Cairo", "Tajawal", system-ui, sans-serif;
        color: var(--ivory);
        background:
          linear-gradient(180deg, rgba(9, 9, 8, 0.94), rgba(25, 24, 21, 0.98)),
          repeating-linear-gradient(
            135deg,
            rgba(217, 181, 101, 0.055) 0 1px,
            transparent 1px 22px
          ),
          var(--ink);
        line-height: 1.75;
        overflow-x: hidden;
      }

      ::selection {
        color: var(--ink);
        background: var(--gold-2);
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image:
          linear-gradient(rgba(255, 250, 240, 0.035) 1px, transparent 1px),
          linear-gradient(
            90deg,
            rgba(255, 250, 240, 0.025) 1px,
            transparent 1px
          );
        background-size: 80px 80px;
        mask-image: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.65),
          transparent 72%
        );
        z-index: -1;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -1;
        opacity: 0.34;
        background:
          linear-gradient(
            110deg,
            transparent 0 34%,
            rgba(93, 127, 133, 0.12) 34.1% 34.6%,
            transparent 34.8% 100%
          ),
          linear-gradient(
            70deg,
            transparent 0 66%,
            rgba(217, 181, 101, 0.1) 66.1% 66.5%,
            transparent 66.7% 100%
          );
        mix-blend-mode: screen;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
      }

      button,
      input,
      textarea {
        font: inherit;
      }

      .container {
        width: var(--container);
        margin-inline: auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 30;
        border-bottom: 1px solid var(--line);
        background:
          linear-gradient(
            90deg,
            rgba(217, 181, 101, 0.08),
            transparent 32%,
            rgba(93, 127, 133, 0.08)
          ),
          rgba(9, 9, 8, 0.78);
        backdrop-filter: blur(20px);
      }

      .nav {
        min-height: 74px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
      }

      .brand {
        position: relative;
        display: grid;
        gap: 1px;
        min-width: 190px;
        padding-inline-start: 48px;
      }

      .brand::before {
        content: "ع";
        position: absolute;
        inset-block-start: 50%;
        inset-inline-start: 0;
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(217, 181, 101, 0.62);
        color: var(--gold-2);
        background: rgba(255, 250, 240, 0.06);
        transform: translateY(-50%);
        font-family: "Aref Ruqaa Ink", "Cairo", sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
      }

      .brand::after {
        content: "";
        position: absolute;
        inset-block-start: calc(50% - 9px);
        inset-inline-start: 9px;
        width: 18px;
        height: 18px;
        border: 1px solid rgba(93, 127, 133, 0.7);
        transform: rotate(45deg);
      }

      .brand strong {
        font-size: 1.12rem;
        font-weight: 900;
        color: var(--paper);
      }

      .brand span {
        color: var(--gold);
        font-size: 0.82rem;
        font-weight: 700;
      }

      .nav-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(12px, 2vw, 28px);
        color: rgba(248, 243, 232, 0.78);
        font-size: 0.93rem;
        font-weight: 700;
      }

      .nav-links a {
        padding-block: 22px;
        border-bottom: 2px solid transparent;
        transition:
          color 200ms ease,
          border-color 200ms ease;
      }

      .nav-links a:hover,
      .nav-links a:focus-visible {
        color: var(--gold-2);
        border-color: var(--gold);
      }

      .nav-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border: 1px solid rgba(217, 181, 101, 0.58);
        border-radius: 6px;
        color: var(--ink);
        background: linear-gradient(135deg, var(--gold), var(--gold-2));
        font-weight: 900;
        box-shadow: 0 14px 34px rgba(217, 181, 101, 0.16);
        transition:
          transform 180ms ease,
          box-shadow 180ms ease;
        white-space: nowrap;
      }

      .nav-action:hover,
      .nav-action:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(217, 181, 101, 0.24);
      }

      .hero {
        position: relative;
        isolation: isolate;
        min-height: 88svh;
        overflow: hidden;
        display: grid;
        align-items: center;
        border-bottom: 1px solid var(--line);
      }

      .hero-media {
        position: absolute;
        inset: 0;
        z-index: -2;
        background: var(--charcoal);
      }

      .hero-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(0.58) contrast(1.08) brightness(0.78);
        transform: scale(1.04);
        animation: imageDrift 22s ease-in-out infinite alternate;
      }

      .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
          linear-gradient(
            90deg,
            transparent 0 24%,
            rgba(217, 181, 101, 0.16) 24.1% 24.3%,
            transparent 24.4% 100%
          ),
          linear-gradient(
            0deg,
            transparent 0 68%,
            rgba(93, 127, 133, 0.16) 68.1% 68.25%,
            transparent 68.35% 100%
          ),
          repeating-linear-gradient(
            90deg,
            rgba(255, 250, 240, 0.055) 0 1px,
            transparent 1px 120px
          );
        opacity: 0.55;
        mix-blend-mode: screen;
      }

      .hero::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
          linear-gradient(
            90deg,
            rgba(9, 9, 8, 0.98) 0%,
            rgba(9, 9, 8, 0.78) 45%,
            rgba(9, 9, 8, 0.42) 100%
          ),
          linear-gradient(
            0deg,
            rgba(9, 9, 8, 0.98) 0%,
            rgba(9, 9, 8, 0.12) 48%,
            rgba(9, 9, 8, 0.62) 100%
          );
      }

      .hero-seal {
        position: absolute;
        inset-block-start: 126px;
        inset-inline-end: clamp(20px, 5vw, 78px);
        width: 128px;
        height: 128px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(217, 181, 101, 0.36);
        color: rgba(255, 250, 240, 0.8);
        background: rgba(9, 9, 8, 0.42);
        backdrop-filter: blur(10px);
        transform: rotate(-8deg);
        z-index: 2;
      }

      .hero-seal::before,
      .hero-seal::after {
        content: "";
        position: absolute;
        inset: 10px;
        border: 1px solid rgba(93, 127, 133, 0.4);
      }

      .hero-seal::after {
        inset: 22px;
        border-color: rgba(217, 181, 101, 0.34);
        transform: rotate(45deg);
      }

      .hero-seal span {
        position: relative;
        z-index: 1;
        max-width: 76px;
        text-align: center;
        color: var(--gold-2);
        font-size: 0.78rem;
        font-weight: 900;
        line-height: 1.5;
      }

      .hero-ruler {
        position: absolute;
        inset-inline-start: clamp(12px, 3vw, 46px);
        inset-block: 118px 64px;
        width: 36px;
        border-inline-start: 1px solid rgba(217, 181, 101, 0.42);
        background: repeating-linear-gradient(
          to bottom,
          rgba(217, 181, 101, 0.42) 0 1px,
          transparent 1px 34px
        );
        opacity: 0.72;
        z-index: 1;
      }

      .hero-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(340px, 0.62fr);
        gap: clamp(26px, 5vw, 76px);
        align-items: center;
        padding: clamp(54px, 8vw, 92px) 0 clamp(46px, 6vw, 72px);
      }

      .hero-content {
        position: relative;
        padding-top: 18px;
      }

      .hero-content::before {
        content: "";
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        width: min(520px, 70%);
        height: 1px;
        background: linear-gradient(90deg, var(--gold), transparent);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--gold-2);
        font-weight: 900;
        margin-bottom: 18px;
      }

      .eyebrow::before {
        content: "";
        width: 48px;
        height: 1px;
        background: var(--gold);
      }

      .hero h1 {
        position: relative;
        margin: 0;
        max-width: 760px;
        font-family: "Aref Ruqaa Ink", "Cairo", sans-serif;
        font-size: 5.9rem;
        line-height: 1.05;
        font-weight: 700;
        letter-spacing: 0;
        color: var(--paper);
        text-wrap: balance;
        text-shadow: 0 22px 46px rgba(0, 0, 0, 0.46);
        animation: titleReveal 900ms ease both;
      }

      .hero h1::after {
        content: "";
        display: block;
        width: 132px;
        height: 7px;
        margin-top: 18px;
        background: linear-gradient(
          90deg,
          var(--gold-2) 0 44%,
          transparent 44% 50%,
          var(--blueprint-2) 50% 74%,
          transparent 74% 80%,
          var(--wine) 80% 100%
        );
        border-radius: 4px;
      }

      .hero-copy {
        margin: 24px 0 0;
        max-width: 670px;
        color: rgba(248, 243, 232, 0.82);
        font-size: 1.16rem;
        text-wrap: pretty;
      }

      .hero-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 34px;
        max-width: 730px;
      }

      .meta-item {
        position: relative;
        border: 1px solid var(--line);
        background:
          linear-gradient(
            135deg,
            rgba(217, 181, 101, 0.08),
            rgba(255, 250, 240, 0.04)
          ),
          rgba(255, 250, 240, 0.07);
        backdrop-filter: blur(18px);
        border-radius: var(--radius);
        padding: 14px 16px;
        min-height: 90px;
        overflow: hidden;
      }

      .meta-item::before {
        content: "";
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        width: 3px;
        background: linear-gradient(var(--gold), var(--blueprint-2));
      }

      .meta-item span {
        display: block;
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 700;
      }

      .meta-item strong {
        display: block;
        margin-top: 6px;
        color: var(--paper);
        font-size: 1.08rem;
        font-weight: 900;
      }

      .hero-panel {
        position: relative;
        border: 1px solid rgba(248, 243, 232, 0.2);
        border-radius: var(--radius);
        background:
          linear-gradient(
            150deg,
            rgba(41, 61, 74, 0.42),
            rgba(16, 15, 13, 0.7) 45%,
            rgba(156, 111, 56, 0.18)
          ),
          var(--glass);
        backdrop-filter: blur(22px);
        box-shadow: var(--shadow);
        padding: clamp(20px, 3vw, 28px);
        overflow: hidden;
      }

      .hero-panel::before {
        content: "";
        position: absolute;
        inset: 12px;
        border: 1px solid rgba(217, 181, 101, 0.16);
        pointer-events: none;
      }

      .hero-panel::after {
        content: "";
        position: absolute;
        inset-block-start: -40px;
        inset-inline-end: -42px;
        width: 160px;
        height: 160px;
        border: 1px solid rgba(217, 181, 101, 0.2);
        transform: rotate(45deg);
        pointer-events: none;
      }

      .panel-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 20px;
      }

      .panel-title h2,
      .section-title h2 {
        margin: 0;
        color: var(--paper);
        font-size: 2.05rem;
        line-height: 1.25;
        font-weight: 900;
      }

      .panel-title span,
      .section-title p {
        color: var(--muted);
        font-weight: 700;
      }

      .countdown {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-bottom: 22px;
      }

      .count-box {
        position: relative;
        display: grid;
        place-items: center;
        min-height: 92px;
        border: 1px solid rgba(248, 243, 232, 0.14);
        border-radius: var(--radius);
        background: rgba(255, 250, 240, 0.08);
        overflow: hidden;
      }

      .count-box::before {
        content: "";
        position: absolute;
        inset-inline: 14px;
        inset-block-start: 10px;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(217, 181, 101, 0.72),
          transparent
        );
      }

      .count-box strong {
        font-size: 2.14rem;
        line-height: 1;
        color: var(--gold-2);
        font-weight: 900;
      }

      .count-box span {
        color: rgba(248, 243, 232, 0.74);
        font-size: 0.78rem;
        font-weight: 800;
      }

      .overall-progress {
        display: grid;
        gap: 12px;
      }

      .progress-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        color: rgba(248, 243, 232, 0.82);
        font-weight: 800;
      }

      .progress-head strong {
        color: var(--gold-2);
        font-size: 1.28rem;
        font-weight: 900;
      }

      .progress-track {
        position: relative;
        overflow: hidden;
        height: 12px;
        border-radius: 6px;
        background: rgba(255, 250, 240, 0.12);
        border: 1px solid rgba(248, 243, 232, 0.1);
      }

      .progress-fill {
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        width: 0;
        border-radius: inherit;
        background: linear-gradient(
          90deg,
          var(--bronze),
          var(--gold-2),
          var(--sage)
        );
        box-shadow: 0 0 24px rgba(217, 181, 101, 0.3);
        transition: width 1100ms cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      main section {
        padding: clamp(62px, 8vw, 104px) 0;
      }

      .section-title {
        position: relative;
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: clamp(28px, 4vw, 48px);
        padding-top: 18px;
      }

      .section-title::before {
        content: "";
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        width: 86px;
        height: 3px;
        background: linear-gradient(
          90deg,
          var(--gold) 0 46%,
          transparent 46% 54%,
          var(--blueprint-2) 54% 100%
        );
        border-radius: 3px;
      }

      .section-title h2 {
        font-family: "Aref Ruqaa Ink", "Cairo", sans-serif;
        font-weight: 700;
      }

      .section-title p {
        margin: 0;
        max-width: 530px;
        font-size: 0.98rem;
      }

      .timeline {
        position: relative;
        display: grid;
        grid-template-columns: repeat(6, minmax(160px, 1fr));
        gap: 12px;
        counter-reset: stage;
      }

      .timeline::before {
        content: "";
        position: absolute;
        top: 34px;
        inset-inline: 0;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(217, 181, 101, 0.58),
          transparent
        );
      }

      .stage {
        position: relative;
        counter-increment: stage;
        min-height: 280px;
        border: 1px solid rgba(248, 243, 232, 0.16);
        border-radius: var(--radius);
        background:
          linear-gradient(
            180deg,
            rgba(255, 250, 240, 0.07),
            rgba(255, 250, 240, 0.035)
          ),
          rgba(255, 250, 240, 0.055);
        backdrop-filter: blur(18px);
        padding: 20px;
        overflow: hidden;
        transition:
          transform 220ms ease,
          border-color 220ms ease,
          background 220ms ease;
      }

      .stage:hover {
        transform: translateY(-6px);
        border-color: rgba(217, 181, 101, 0.46);
        background:
          linear-gradient(
            180deg,
            rgba(217, 181, 101, 0.13),
            rgba(255, 250, 240, 0.04)
          ),
          rgba(255, 250, 240, 0.055);
      }

      .stage::before {
        content: "";
        position: absolute;
        top: 28px;
        inset-inline-start: 20px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--stage-color, var(--muted));
        box-shadow: 0 0 0 6px rgba(255, 250, 240, 0.08);
      }

      .stage::after {
        content: counter(stage, decimal-leading-zero);
        position: absolute;
        inset-inline-end: 16px;
        inset-block-start: 8px;
        color: rgba(255, 250, 240, 0.07);
        font-family: "Aref Ruqaa Ink", "Cairo", sans-serif;
        font-size: 4.6rem;
        line-height: 1;
        font-weight: 700;
      }

      .stage.completed {
        --stage-color: var(--sage);
      }

      .stage.current {
        --stage-color: var(--gold);
        border-color: rgba(217, 181, 101, 0.48);
        background: linear-gradient(
          180deg,
          rgba(217, 181, 101, 0.13),
          rgba(255, 250, 240, 0.055)
        );
      }

      .stage.upcoming {
        --stage-color: rgba(248, 243, 232, 0.32);
      }

      .stage-status {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 0 10px;
        border: 1px solid rgba(248, 243, 232, 0.16);
        border-radius: 6px;
        color: var(--stage-color);
        font-size: 0.78rem;
        font-weight: 900;
        background: rgba(9, 9, 8, 0.42);
      }

      .stage h3 {
        margin: 52px 0 8px;
        color: var(--paper);
        font-size: 1.16rem;
        line-height: 1.35;
      }

      .stage p {
        margin: 0 0 16px;
        color: var(--muted);
        font-size: 0.88rem;
        min-height: 62px;
      }

      .stage-date {
        display: grid;
        gap: 4px;
        color: rgba(248, 243, 232, 0.76);
        font-size: 0.84rem;
        font-weight: 700;
        margin-bottom: 18px;
      }

      .stage-progress {
        display: grid;
        gap: 8px;
        margin-top: auto;
      }

      .stage-progress .progress-track {
        height: 9px;
      }

      .stage-progress span {
        color: var(--gold-2);
        font-weight: 900;
        font-size: 0.9rem;
      }

      .updates-section {
        background:
          linear-gradient(180deg, rgba(255, 250, 240, 0.035), transparent),
          rgba(255, 250, 240, 0.025);
        border-block: 1px solid var(--line);
      }

      .updates-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        align-items: stretch;
      }

      .update-card {
        position: relative;
        display: grid;
        grid-template-rows: auto 1fr;
        min-height: 360px;
        border: 1px solid rgba(248, 243, 232, 0.15);
        border-radius: var(--radius);
        overflow: hidden;
        background:
          linear-gradient(
            160deg,
            rgba(41, 61, 74, 0.2),
            rgba(16, 15, 13, 0.62) 50%,
            rgba(110, 43, 53, 0.12)
          ),
          rgba(16, 15, 13, 0.62);
        box-shadow: 0 18px 56px rgba(0, 0, 0, 0.22);
        transition:
          transform 220ms ease,
          border-color 220ms ease;
      }

      .update-card:first-child {
        grid-column: span 2;
      }

      .update-card:hover {
        transform: translateY(-5px);
        border-color: rgba(217, 181, 101, 0.44);
      }

      .update-card::before {
        content: "";
        position: absolute;
        inset-inline-start: 0;
        inset-block: 0;
        width: 4px;
        background: linear-gradient(
          var(--gold),
          var(--wine),
          var(--blueprint-2)
        );
        z-index: 2;
      }

      .update-card img {
        width: 100%;
        height: 150px;
        object-fit: cover;
        filter: saturate(0.82) contrast(1.03);
      }

      .update-card:first-child img {
        height: 210px;
      }

      .update-body {
        padding: 18px;
        display: grid;
        gap: 10px;
        align-content: start;
      }

      .date-tag {
        color: var(--gold-2);
        font-weight: 900;
        font-size: 0.82rem;
      }

      .update-body h3,
      .gallery-card h3 {
        margin: 0;
        color: var(--paper);
        line-height: 1.35;
        font-size: 1.08rem;
      }

      .update-body p,
      .gallery-card p {
        margin: 0;
        color: rgba(248, 243, 232, 0.72);
        font-size: 0.9rem;
      }

      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 22px;
      }

      .filter-btn {
        min-height: 40px;
        border: 1px solid rgba(248, 243, 232, 0.18);
        border-radius: 6px;
        color: rgba(248, 243, 232, 0.78);
        background: rgba(255, 250, 240, 0.06);
        cursor: pointer;
        padding: 0 16px;
        font-weight: 900;
        transition:
          border-color 180ms ease,
          color 180ms ease,
          background 180ms ease;
      }

      .filter-btn:hover,
      .filter-btn:focus-visible,
      .filter-btn.active {
        color: var(--ink);
        border-color: var(--gold);
        background: var(--gold);
      }

      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        align-items: stretch;
      }

      .gallery-card {
        position: relative;
        min-height: 300px;
        overflow: hidden;
        border-radius: var(--radius);
        border: 1px solid rgba(248, 243, 232, 0.15);
        background: var(--charcoal);
        box-shadow: 0 22px 70px rgba(0, 0, 0, 0.28);
        cursor: pointer;
      }

      .gallery-card.featured {
        grid-column: span 2;
        min-height: 400px;
      }

      .gallery-card.plan-card {
        background: #0d0d0c;
      }

      .gallery-card.plan-card img {
        object-fit: contain !important;
        filter: none;
        padding: 10px;
      }

      .gallery-card.plan-card:hover img {
        filter: none;
      }

      .gallery-card.video-card {
        cursor: pointer;
      }

      .video-play-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 68px;
        height: 68px;
        background: rgba(0, 0, 0, 0.7);
        border: 2px solid rgba(217, 181, 101, 0.5);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        pointer-events: none;
        transition: transform 200ms ease, background 200ms ease;
      }

      .gallery-card.video-card:hover .video-play-overlay {
        transform: translate(-50%, -50%) scale(1.1);
        background: rgba(156, 111, 56, 0.85);
      }

      /* Apartment Models Section */
      .apartment-models-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .apartment-model-card {
        border: 1px solid rgba(248, 243, 232, 0.14);
        border-radius: var(--radius);
        overflow: hidden;
        background: linear-gradient(160deg, rgba(41, 61, 74, 0.15), rgba(16, 15, 13, 0.62));
        box-shadow: 0 18px 56px rgba(0, 0, 0, 0.22);
        transition: transform 220ms ease, border-color 220ms ease;
      }

      .apartment-model-card:hover {
        transform: translateY(-5px);
        border-color: rgba(217, 181, 101, 0.44);
      }

      .model-visual {
        position: relative;
        height: 280px;
        background: #0d0d0c;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      .model-visual img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 8px;
      }

      .model-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: var(--gold);
        color: var(--ink);
        font-size: 0.78rem;
        font-weight: 900;
        padding: 4px 12px;
        border-radius: 6px;
      }

      .model-info {
        padding: 18px;
      }

      .model-info h3 {
        margin: 0 0 8px;
        color: var(--paper);
        font-size: 1.15rem;
        font-weight: 900;
      }

      .model-specs {
        margin-bottom: 8px;
      }

      .spec-item {
        display: inline-block;
        color: var(--gold-2);
        font-size: 0.88rem;
        font-weight: 800;
      }

      .model-info p {
        margin: 0;
        color: rgba(248, 243, 232, 0.68);
        font-size: 0.88rem;
      }

      /* Video Modal */
      .video-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0, 0, 0, 0.92);
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .video-modal-overlay.show {
        display: flex;
      }

      .video-modal-content {
        position: relative;
        width: 100%;
        max-width: 900px;
        aspect-ratio: 16/9;
        border-radius: var(--radius);
        overflow: hidden;
        border: 1px solid rgba(217, 181, 101, 0.3);
        box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6);
      }

      .video-modal-content video {
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: #000;
      }

      .video-modal-close {
        position: absolute;
        top: -48px;
        right: 0;
        background: none;
        border: none;
        color: var(--paper);
        font-size: 1.8rem;
        cursor: pointer;
        font-weight: 900;
        padding: 8px;
      }

      /* Admin Updates Section */
      .admin-section {
        margin: 40px 0;
        padding: 30px;
        background: linear-gradient(160deg, rgba(41, 61, 74, 0.15), rgba(16, 15, 13, 0.62));
        border: 1px solid rgba(248, 243, 232, 0.14);
        border-radius: var(--radius);
        box-shadow: 0 18px 56px rgba(0, 0, 0, 0.22);
      }

      .admin-updates-table {
        width: 100%;
        border-collapse: collapse;
        background: rgba(255, 255, 255, 0.7);
        border-radius: var(--radius);
        overflow: hidden;
      }

      .admin-updates-table th,
      .admin-updates-table td {
        padding: 12px 10px;
        text-align: right;
        border-bottom: 1px solid rgba(20, 18, 14, 0.09);
        font-size: 0.9rem;
      }

      .admin-updates-table th {
        background: rgba(238, 226, 204, 0.7);
        color: #4c4337;
        font-weight: 900;
      }

      .admin-updates-table td {
        color: #2b261f;
        font-weight: 700;
      }

      .update-form {
        display: grid;
        gap: 16px;
      }

      .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.8);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .modal-overlay.show {
        display: flex;
      }

      .modal-content {
        background: var(--charcoal);
        border: 1px solid rgba(217, 181, 101, 0.3);
        border-radius: var(--radius);
        padding: 24px;
        max-width: 600px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
      }

      .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
      }

      .modal-header h3 {
        margin: 0;
        color: var(--paper);
        font-size: 1.3rem;
        font-weight: 900;
      }

      .modal-close {
        background: none;
        border: none;
        color: var(--gold);
        font-size: 1.5rem;
        cursor: pointer;
        padding: 4px;
      }

      .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 20px;
      }

      /* Image Modal */
      .image-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.92);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .image-modal-overlay.show {
        display: flex;
      }

      .image-modal-content {
        position: relative;
        max-width: 90vw;
        max-height: 90vh;
      }

      .image-modal-close {
        position: absolute;
        top: -48px;
        right: 0;
        background: none;
        border: none;
        color: var(--paper);
        font-size: 1.8rem;
        cursor: pointer;
        font-weight: 900;
        padding: 8px;
      }

      .gallery-card[hidden] {
        display: none;
      }

      .gallery-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        inset: 0;
        filter: saturate(0.78) contrast(1.04);
        transition:
          transform 600ms ease,
          filter 300ms ease;
      }

      .gallery-card:hover img {
        transform: scale(1.045);
        filter: saturate(0.95) contrast(1.05);
      }

      .gallery-card::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(180deg, transparent 32%, rgba(9, 9, 8, 0.92) 100%),
          linear-gradient(90deg, rgba(41, 61, 74, 0.22), transparent 48%);
      }

      .gallery-card::before {
        content: "";
        position: absolute;
        inset: 14px;
        border: 1px solid rgba(255, 250, 240, 0.14);
        z-index: 2;
        pointer-events: none;
        opacity: 0;
        transition: opacity 240ms ease;
      }

      .gallery-card:hover::before {
        opacity: 1;
      }

      .gallery-caption {
        position: absolute;
        inset-inline: 18px;
        inset-block-end: 18px;
        z-index: 2;
      }

      .gallery-label {
        display: inline-flex;
        min-height: 28px;
        align-items: center;
        margin-bottom: 10px;
        padding: 0 10px;
        border-radius: 6px;
        color: var(--ink);
        background: var(--gold-2);
        font-size: 0.76rem;
        font-weight: 900;
      }

      .stats-layout {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: 18px;
        align-items: stretch;
      }

      .stats-visual {
        position: relative;
        min-height: 540px;
        overflow: hidden;
        border-radius: var(--radius);
        border: 1px solid rgba(248, 243, 232, 0.14);
        background: var(--blueprint);
      }

      .stats-visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(0.7) contrast(1.06);
      }

      .stats-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          repeating-linear-gradient(
            90deg,
            rgba(255, 250, 240, 0.06) 0 1px,
            transparent 1px 86px
          ),
          linear-gradient(0deg, rgba(9, 9, 8, 0.82), rgba(9, 9, 8, 0.08));
      }

      .stats-badge {
        position: absolute;
        inset-inline: 22px;
        inset-block-end: 22px;
        z-index: 2;
        border: 1px solid rgba(248, 243, 232, 0.18);
        border-radius: var(--radius);
        background: rgba(9, 9, 8, 0.68);
        backdrop-filter: blur(18px);
        padding: 18px;
      }

      .stats-badge span {
        color: var(--muted);
        font-weight: 800;
        font-size: 0.9rem;
      }

      .stats-badge strong {
        display: block;
        color: var(--gold-2);
        font-size: 4.1rem;
        line-height: 1;
        font-weight: 900;
        margin-top: 8px;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .stat-card {
        position: relative;
        border: 1px solid rgba(248, 243, 232, 0.15);
        border-radius: var(--radius);
        background:
          linear-gradient(
            135deg,
            rgba(255, 250, 240, 0.08),
            rgba(255, 250, 240, 0.035)
          ),
          rgba(255, 250, 240, 0.06);
        padding: clamp(20px, 3vw, 28px);
        min-height: 170px;
        display: grid;
        align-content: space-between;
        overflow: hidden;
        transition:
          transform 220ms ease,
          border-color 220ms ease;
      }

      .stat-card:hover {
        transform: translateY(-5px);
        border-color: rgba(93, 127, 133, 0.58);
      }

      .stat-card::after {
        content: "";
        position: absolute;
        inset-inline-end: -46px;
        inset-block-start: -46px;
        width: 120px;
        height: 120px;
        border: 1px solid rgba(217, 181, 101, 0.18);
        transform: rotate(45deg);
      }

      .stat-card span {
        color: var(--muted);
        font-weight: 800;
      }

      .stat-card strong {
        color: var(--paper);
        font-size: 3rem;
        line-height: 1.1;
        font-weight: 900;
      }

      .stat-card small {
        color: rgba(248, 243, 232, 0.68);
        font-size: 0.86rem;
        font-weight: 700;
      }

      .contact-section {
        position: relative;
        overflow: hidden;
        border-top: 1px solid var(--line);
        background:
          repeating-linear-gradient(
            135deg,
            rgba(217, 181, 101, 0.06) 0 1px,
            transparent 1px 28px
          ),
          linear-gradient(
            135deg,
            rgba(217, 181, 101, 0.12),
            rgba(95, 113, 93, 0.1),
            rgba(41, 61, 74, 0.16)
          ),
          var(--ink-2);
      }

      .contact-layout {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: clamp(20px, 5vw, 70px);
        align-items: start;
      }

      .contact-card,
      .contact-form {
        position: relative;
        border: 1px solid rgba(248, 243, 232, 0.16);
        border-radius: var(--radius);
        background: rgba(9, 9, 8, 0.62);
        backdrop-filter: blur(20px);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .contact-card::before,
      .contact-form::before {
        content: "";
        position: absolute;
        inset-inline: 0;
        inset-block-start: 0;
        height: 4px;
        background: linear-gradient(
          90deg,
          var(--gold),
          var(--blueprint-2),
          var(--wine)
        );
      }

      .contact-card {
        padding: clamp(22px, 3vw, 34px);
      }

      .contact-card h2 {
        margin: 0 0 16px;
        font-family: "Aref Ruqaa Ink", "Cairo", sans-serif;
        font-size: 2.9rem;
        font-weight: 700;
        line-height: 1.2;
        color: var(--paper);
      }

      .contact-card p {
        margin: 0 0 24px;
        color: rgba(248, 243, 232, 0.76);
      }

      .contact-list {
        display: grid;
        gap: 12px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .contact-list li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        border-bottom: 1px solid rgba(248, 243, 232, 0.1);
        padding-bottom: 12px;
        color: rgba(248, 243, 232, 0.8);
        font-weight: 800;
      }

      .contact-list strong {
        color: var(--gold-2);
        font-weight: 900;
        text-align: left;
        direction: ltr;
      }

      .contact-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-top: 24px;
      }

      .btn {
        position: relative;
        overflow: hidden;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-height: 48px;
        border-radius: 6px;
        border: 1px solid rgba(217, 181, 101, 0.54);
        cursor: pointer;
        font-weight: 900;
        transition:
          transform 180ms ease,
          background 180ms ease,
          color 180ms ease;
      }

      .btn::after {
        content: "";
        position: absolute;
        inset-block: 8px;
        inset-inline-start: -34%;
        width: 24%;
        background: rgba(255, 255, 255, 0.26);
        transform: skewX(-18deg);
        transition: inset-inline-start 320ms ease;
      }

      .btn.primary {
        color: var(--ink);
        background: var(--gold);
      }

      .btn.secondary {
        color: var(--paper);
        background: rgba(255, 250, 240, 0.08);
      }

      .feature-list .btn.secondary {
        color: var(--ink);
        background: var(--gold);
        border: 1px solid var(--bronze);
      }

      .feature-list .btn.secondary:hover {
        background: var(--gold-2);
        color: var(--ink-2);
      }

      .admin-topline .btn.secondary {
        color: var(--ink);
        background: var(--gold);
        border: 1px solid var(--bronze);
      }

      .admin-topline .btn.secondary:hover {
        background: var(--gold-2);
        color: var(--ink-2);
      }

      .btn:hover,
      .btn:focus-visible {
        transform: translateY(-2px);
      }

      .btn:hover::after,
      .btn:focus-visible::after {
        inset-inline-start: 112%;
      }

      .contact-form {
        padding: clamp(20px, 3vw, 30px);
        display: grid;
        gap: 14px;
      }

      .field {
        display: grid;
        gap: 8px;
      }

      .field label {
        color: var(--gold-2);
        font-weight: 900;
        font-size: 0.9rem;
      }

      .field input,
      .field textarea {
        width: 100%;
        color: var(--paper);
        border: 1px solid rgba(248, 243, 232, 0.17);
        border-radius: 6px;
        background: rgba(255, 250, 240, 0.07);
        padding: 14px 16px;
        outline: none;
        transition:
          border-color 180ms ease,
          box-shadow 180ms ease;
      }

      .field textarea {
        min-height: 130px;
        resize: vertical;
      }

      .field input:focus,
      .field textarea:focus {
        border-color: var(--gold);
        box-shadow: 0 0 0 3px rgba(217, 181, 101, 0.12);
      }

      .footer {
        border-top: 1px solid var(--line);
        padding: 26px 0;
        color: rgba(248, 243, 232, 0.62);
        background: var(--ink);
        font-weight: 700;
      }

      .footer .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
      }

      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition:
          opacity 700ms ease,
          transform 700ms ease,
          border-color 220ms ease,
          background 220ms ease,
          box-shadow 220ms ease;
        transition-delay: var(--delay, 0ms);
      }

      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .stage.visible:hover,
      .update-card.visible:hover,
      .stat-card.visible:hover {
        transform: translateY(-6px);
      }

      @keyframes imageDrift {
        from {
          transform: scale(1.04) translate3d(0, 0, 0);
        }
        to {
          transform: scale(1.1) translate3d(-18px, 10px, 0);
        }
      }

      @keyframes titleReveal {
        from {
          opacity: 0;
          transform: translateY(22px);
          filter: blur(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @media (max-width: 1120px) {
        .timeline {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .timeline::before {
          display: none;
        }

        .updates-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .update-card:first-child {
          grid-column: span 1;
        }
      }

      @media (max-width: 900px) {
        .nav {
          align-items: start;
          padding: 14px 0;
          min-height: auto;
        }

        .nav-links {
          display: none;
        }

        .hero {
          min-height: auto;
        }

        .hero h1 {
          font-size: 4.4rem;
        }

        .hero-seal {
          inset-block-start: 104px;
          width: 104px;
          height: 104px;
        }

        .hero-layout,
        .stats-layout,
        .contact-layout {
          grid-template-columns: 1fr;
        }

        .hero-meta,
        .stats-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .gallery-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .gallery-card.featured {
          grid-row: span 1;
          min-height: 360px;
        }

        .stats-visual {
          min-height: 430px;
        }

        .stats-badge strong {
          font-size: 3.2rem;
        }
      }

      @media (max-width: 640px) {
        :root {
          --container: min(100% - 24px, 1180px);
        }

        .site-header {
          position: static;
        }

        .nav {
          gap: 12px;
        }

        .brand {
          min-width: 0;
        }

        .nav-action {
          min-height: 38px;
          padding: 0 12px;
          font-size: 0.84rem;
        }

        .hero-layout {
          padding-top: 44px;
        }

        .hero-ruler,
        .hero-seal {
          display: none;
        }

        .hero h1 {
          font-size: 3.02rem;
        }

        .hero-copy {
          font-size: 1rem;
        }

        .panel-title h2,
        .section-title h2 {
          font-size: 1.58rem;
        }

        .count-box strong {
          font-size: 1.9rem;
        }

        .stats-badge strong,
        .stat-card strong,
        .contact-card h2 {
          font-size: 2.35rem;
        }

        .hero-meta,
        .countdown,
        .timeline,
        .updates-grid,
        .gallery-grid,
        .stats-grid,
        .contact-actions,
        .apartment-models-grid {
          grid-template-columns: 1fr;
        }

        .gallery-card.featured {
          grid-column: span 1;
        }

        .meta-item {
          min-height: auto;
        }

        .count-box {
          min-height: 78px;
        }

        .section-title {
          display: grid;
          gap: 12px;
        }

        .stage {
          min-height: auto;
        }

        .update-card {
          min-height: auto;
        }

        .gallery-card,
        .gallery-card.featured {
          min-height: 280px;
        }

        .footer .container {
          display: grid;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
      .reservation-section {
        position: relative;
        overflow: hidden;
        border-block: 1px solid rgba(248, 243, 232, 0.16);
        background:
          linear-gradient(
            120deg,
            rgba(248, 243, 232, 0.94),
            rgba(238, 226, 204, 0.92)
          ),
          var(--paper);
        color: #161411;
      }

      .reservation-section::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            90deg,
            rgba(156, 111, 56, 0.08) 0 1px,
            transparent 1px 100%
          ),
          linear-gradient(
            0deg,
            rgba(41, 61, 74, 0.08) 0 1px,
            transparent 1px 100%
          ),
          repeating-linear-gradient(
            135deg,
            rgba(156, 111, 56, 0.07) 0 1px,
            transparent 1px 24px
          );
        background-size:
          92px 92px,
          92px 92px,
          auto;
        pointer-events: none;
      }

      .reservation-section::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        inset-block-start: 0;
        height: 8px;
        background: linear-gradient(
          90deg,
          var(--gold),
          var(--blueprint-2),
          var(--wine),
          var(--gold)
        );
        opacity: 0.86;
      }

      .reservation-shell {
        position: relative;
        z-index: 1;
      }

      .reservation-kicker {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-height: 34px;
        margin-bottom: 14px;
        color: #6f4b1f;
        font-weight: 900;
      }

      .reservation-kicker::before {
        content: "";
        width: 42px;
        height: 1px;
        background: #6f4b1f;
      }

      .reservation-heading {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(300px, 0.48fr);
        gap: 32px;
        align-items: end;
        margin-bottom: 28px;
      }

      .reservation-heading h2 {
        margin: 0;
        max-width: 820px;
        color: #14120e;
        font-family: "Aref Ruqaa Ink", "Cairo", sans-serif;
        font-size: 3.4rem;
        line-height: 1.12;
        font-weight: 700;
      }

      .reservation-heading p {
        margin: 0;
        color: #5f574b;
        font-weight: 700;
      }

      .portal-tabs {
        display: inline-grid;
        grid-template-columns: repeat(2, minmax(160px, 1fr));
        gap: 6px;
        padding: 6px;
        margin-bottom: 22px;
        border: 1px solid rgba(20, 18, 14, 0.12);
        border-radius: var(--radius);
        background: rgba(255, 255, 255, 0.52);
        box-shadow: 0 18px 50px rgba(20, 18, 14, 0.08);
      }

      .portal-tab {
        min-height: 46px;
        border: 0;
        border-radius: 6px;
        color: #3b352c;
        background: transparent;
        cursor: pointer;
        font-weight: 900;
        transition:
          background 180ms ease,
          color 180ms ease,
          box-shadow 180ms ease;
      }

      .portal-tab.active {
        color: var(--paper);
        background: #171512;
        box-shadow: 0 14px 34px rgba(20, 18, 14, 0.18);
      }

      .portal-panel {
        display: none;
      }

      .portal-panel.active {
        display: block;
      }

      .client-access-layout {
        display: grid;
        grid-template-columns: minmax(300px, 0.48fr) minmax(0, 1fr);
        gap: 18px;
        align-items: stretch;
      }

      .client-access-card,
      .private-dashboard,
      .admin-gate,
      .admin-dashboard,
      .control-card,
      .selected-unit-panel,
      .client-table-wrap {
        border: 1px solid rgba(20, 18, 14, 0.12);
        border-radius: var(--radius);
        background:
          linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.74),
            rgba(248, 243, 232, 0.7)
          ),
          rgba(255, 255, 255, 0.66);
        box-shadow: 0 24px 70px rgba(20, 18, 14, 0.1);
      }

      .client-access-card,
      .admin-gate {
        position: relative;
        overflow: hidden;
        padding: 28px;
        min-height: 430px;
      }

      .client-access-card::before,
      .admin-gate::before {
        content: "";
        position: absolute;
        inset-inline-start: 0;
        inset-block: 0;
        width: 5px;
        background: linear-gradient(
          var(--gold),
          var(--blueprint-2),
          var(--wine)
        );
      }

      .client-access-card h3,
      .admin-gate h3,
      .control-card h3,
      .selected-unit-panel h3 {
        margin: 0 0 10px;
        color: #171512;
        font-size: 1.45rem;
        line-height: 1.35;
        font-weight: 900;
      }

      .client-access-card p,
      .admin-gate p,
      .control-card p,
      .selected-unit-panel p {
        margin: 0;
        color: #62584a;
        font-weight: 700;
      }

      .code-form,
      .admin-code-form,
      .management-form,
      .assignment-form,
      .payment-form {
        display: grid;
        gap: 14px;
        margin-top: 24px;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      .form-field {
        display: grid;
        gap: 7px;
      }

      .form-field.full {
        grid-column: 1 / -1;
      }

      .form-field label {
        color: #433929;
        font-size: 0.88rem;
        font-weight: 900;
      }

      .form-field input,
      .form-field select,
      .form-field textarea,
      .search-input,
      .filter-select {
        width: 100%;
        min-height: 46px;
        border: 1px solid rgba(20, 18, 14, 0.16);
        border-radius: 6px;
        color: #171512;
        background: rgba(255, 255, 255, 0.78);
        padding: 11px 13px;
        outline: none;
        font-weight: 700;
        transition:
          border-color 180ms ease,
          box-shadow 180ms ease,
          background 180ms ease;
      }

      .form-field textarea {
        min-height: 92px;
        resize: vertical;
      }

      .form-field input:focus,
      .form-field select:focus,
      .form-field textarea:focus,
      .search-input:focus,
      .filter-select:focus {
        border-color: #9c6f38;
        background: #fffefa;
        box-shadow: 0 0 0 4px rgba(217, 181, 101, 0.2);
      }

      .access-error,
      .access-success,
      .admin-warning {
        display: none;
        border-radius: 6px;
        padding: 12px 14px;
        font-size: 0.92rem;
        font-weight: 800;
      }

      .access-error.show,
      .access-success.show,
      .admin-warning.show {
        display: block;
      }

      .access-error {
        color: #6e2b35;
        background: rgba(110, 43, 53, 0.1);
        border: 1px solid rgba(110, 43, 53, 0.22);
      }

      .access-success {
        color: #2f4b36;
        background: rgba(95, 113, 93, 0.13);
        border: 1px solid rgba(95, 113, 93, 0.24);
      }

      .admin-warning {
        color: #6f4b1f;
        background: rgba(217, 181, 101, 0.14);
        border: 1px solid rgba(156, 111, 56, 0.24);
      }

      .portal-note {
        margin-top: 20px;
        border: 1px solid rgba(41, 61, 74, 0.16);
        border-radius: var(--radius);
        padding: 16px;
        color: #51483b;
        background: rgba(41, 61, 74, 0.07);
        font-weight: 800;
      }

      .access-preview {
        position: relative;
        overflow: hidden;
        min-height: 430px;
        border-radius: var(--radius);
        border: 1px solid rgba(20, 18, 14, 0.12);
        background:
          linear-gradient(
            rgba(20, 18, 14, 0.86),
            rgba(41, 61, 74, 0.74)
          ),
          url("media/facade.jpg")
            center/cover;
        color: var(--paper);
        padding: 28px;
        display: grid;
        align-content: end;
        box-shadow: 0 28px 80px rgba(20, 18, 14, 0.16);
      }

      .access-preview::before {
        content: "";
        position: absolute;
        inset: 18px;
        border: 1px solid rgba(217, 181, 101, 0.22);
        pointer-events: none;
      }

      .access-preview h3 {
        position: relative;
        z-index: 1;
        margin: 0;
        max-width: 520px;
        font-family: "Aref Ruqaa Ink", "Cairo", sans-serif;
        font-size: 2.7rem;
        line-height: 1.16;
      }

      .access-preview p {
        position: relative;
        z-index: 1;
        max-width: 540px;
        color: rgba(255, 250, 240, 0.78);
        font-weight: 800;
      }

      .private-dashboard {
        display: none;
        margin-top: 20px;
        padding: 20px;
        background:
          linear-gradient(
            150deg,
            rgba(255, 255, 255, 0.8),
            rgba(238, 226, 204, 0.74)
          ),
          rgba(255, 255, 255, 0.76);
      }

      .private-dashboard.show {
        display: block;
      }

      .dashboard-topline,
      .admin-topline {
        display: flex;
        align-items: start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
      }

      .dashboard-topline h3,
      .admin-topline h3 {
        margin: 0;
        color: #171512;
        font-size: 1.7rem;
        line-height: 1.3;
        font-weight: 900;
      }

      .dashboard-topline p,
      .admin-topline p {
        margin: 4px 0 0;
        color: #675d50;
        font-weight: 800;
      }

      .dashboard-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 14px;
        align-items: start;
      }

      .info-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
      }

      .info-chip {
        border: 1px solid rgba(20, 18, 14, 0.12);
        border-radius: var(--radius);
        background: rgba(255, 255, 255, 0.68);
        padding: 13px;
      }

      .info-chip span {
        display: block;
        color: #776c5c;
        font-size: 0.8rem;
        font-weight: 900;
      }

      .info-chip strong {
        display: block;
        margin-top: 4px;
        color: #171512;
        font-weight: 900;
        word-break: break-word;
      }

      .premium-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(20, 18, 14, 0.12);
        border-radius: var(--radius);
        background: rgba(255, 255, 255, 0.7);
        padding: 18px;
        box-shadow: 0 18px 52px rgba(20, 18, 14, 0.08);
      }

      .premium-card::before {
        content: "";
        position: absolute;
        inset-inline-start: 0;
        inset-block: 0;
        width: 4px;
        background: linear-gradient(var(--gold), var(--blueprint-2));
      }

      .premium-card h4 {
        margin: 0 0 12px;
        color: #171512;
        font-size: 1.12rem;
        font-weight: 900;
      }

      .payment-numbers {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin: 14px 0;
      }

      .money-box {
        border-radius: 6px;
        padding: 12px;
        color: #171512;
        background: rgba(238, 226, 204, 0.55);
      }

      .money-box span {
        display: block;
        color: #716657;
        font-size: 0.78rem;
        font-weight: 900;
      }

      .money-box strong {
        display: block;
        margin-top: 4px;
        font-size: 1.08rem;
        font-weight: 900;
        direction: ltr;
        text-align: right;
      }

      .progress-line {
        display: grid;
        gap: 8px;
      }

      .progress-line-head {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        color: #51483d;
        font-weight: 900;
      }

      .light-progress-track {
        position: relative;
        overflow: hidden;
        height: 12px;
        border-radius: 999px;
        background: rgba(20, 18, 14, 0.1);
      }

      .light-progress-fill {
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        width: 0%;
        border-radius: inherit;
        background: linear-gradient(90deg, #8d6230, #d9b565, #5d7f85);
        transition: width 700ms ease;
      }

      .apartment-card-layout {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr);
        gap: 14px;
      }

      .apartment-visual {
        min-height: 210px;
        border-radius: var(--radius);
        overflow: hidden;
        background:
          linear-gradient(
            rgba(20, 18, 14, 0.78),
            rgba(41, 61, 74, 0.56)
          ),
          url("media/facade.jpg")
            center/cover;
        border: 1px solid rgba(20, 18, 14, 0.12);
        display: grid;
        align-content: end;
        padding: 14px;
        color: var(--paper);
      }

      .unit-code-large {
        font-size: 2.4rem;
        line-height: 1;
        font-weight: 900;
        letter-spacing: 0;
      }

      .detail-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-top: 10px;
      }

      .detail-item {
        border-bottom: 1px solid rgba(20, 18, 14, 0.1);
        padding-bottom: 8px;
      }

      .detail-item span {
        display: block;
        color: #756a59;
        font-size: 0.78rem;
        font-weight: 900;
      }

      .detail-item strong {
        color: #171512;
        font-weight: 900;
      }

      .feature-list {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 12px;
      }

      .feature-pill,
      .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 28px;
        border-radius: 999px;
        padding: 0 10px;
        font-size: 0.78rem;
        font-weight: 900;
        white-space: nowrap;
      }

      .feature-pill {
        color: #423726;
        background: rgba(217, 181, 101, 0.18);
        border: 1px solid rgba(156, 111, 56, 0.16);
      }

      .status-badge {
        border: 1px solid rgba(20, 18, 14, 0.12);
        color: #3c352b;
        background: rgba(255, 255, 255, 0.65);
      }

      .status-available,
      .status-confirmed,
      .status-fully-paid {
        color: #23462c;
        background: rgba(95, 113, 93, 0.16);
        border-color: rgba(95, 113, 93, 0.22);
      }

      .status-reserved,
      .status-partially-paid {
        color: #6f4b1f;
        background: rgba(217, 181, 101, 0.18);
        border-color: rgba(156, 111, 56, 0.2);
      }

      .status-sold {
        color: #2c3f4a;
        background: rgba(93, 127, 133, 0.16);
        border-color: rgba(93, 127, 133, 0.24);
      }

      .status-pending-payment,
      .status-pending {
        color: #704923;
        background: rgba(183, 121, 66, 0.16);
        border-color: rgba(183, 121, 66, 0.24);
      }

      .status-overdue,
      .status-cancelled,
      .status-rejected {
        color: #6e2b35;
        background: rgba(110, 43, 53, 0.12);
        border-color: rgba(110, 43, 53, 0.22);
      }

      .payment-table {
        width: 100%;
        border-collapse: collapse;
        overflow: hidden;
        border-radius: var(--radius);
      }

      .payment-table th,
      .payment-table td {
        padding: 12px 10px;
        border-bottom: 1px solid rgba(20, 18, 14, 0.09);
        text-align: right;
        vertical-align: top;
        font-size: 0.9rem;
      }

      .payment-table th {
        color: #4c4337;
        background: rgba(238, 226, 204, 0.7);
        font-weight: 900;
      }

      .payment-table td {
        color: #2b261f;
        font-weight: 700;
      }

      .admin-dashboard {
        display: none;
        margin-top: 18px;
        padding: 20px;
      }

      .admin-dashboard.show {
        display: block;
      }

      .admin-overview {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 16px;
      }

      .overview-card {
        position: relative;
        overflow: hidden;
        min-height: 120px;
        border-radius: var(--radius);
        border: 1px solid rgba(20, 18, 14, 0.1);
        background:
          linear-gradient(
            150deg,
            rgba(255, 255, 255, 0.82),
            rgba(238, 226, 204, 0.54)
          ),
          rgba(255, 255, 255, 0.7);
        padding: 14px;
      }

      .overview-card::after {
        content: "";
        position: absolute;
        inset-inline-end: -38px;
        inset-block-start: -38px;
        width: 92px;
        height: 92px;
        border: 1px solid rgba(156, 111, 56, 0.16);
        transform: rotate(45deg);
      }

      .overview-card span {
        color: #6d6253;
        font-size: 0.78rem;
        font-weight: 900;
      }

      .overview-card strong {
        display: block;
        margin-top: 10px;
        color: #171512;
        font-size: 1.6rem;
        line-height: 1.1;
        font-weight: 900;
        word-break: break-word;
      }

      .admin-tools {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 14px;
        align-items: start;
      }

      .control-card,
      .selected-unit-panel,
      .client-table-wrap {
        padding: 16px;
      }

      .admin-search {
        display: grid;
        grid-template-columns: minmax(240px, 1fr) 220px;
        gap: 10px;
        margin-bottom: 14px;
      }

      .building-map {
        display: grid;
        gap: 10px;
      }

      .floor-row {
        display: grid;
        grid-template-columns: 92px repeat(3, minmax(0, 1fr));
        gap: 10px;
        align-items: stretch;
      }

      .floor-label {
        display: grid;
        place-items: center;
        border-radius: var(--radius);
        color: var(--paper);
        background: linear-gradient(150deg, #171512, #293d4a);
        font-weight: 900;
        min-height: 132px;
        text-align: center;
      }

      .unit-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(20, 18, 14, 0.12);
        border-radius: var(--radius);
        background: rgba(255, 255, 255, 0.7);
        padding: 13px;
        cursor: pointer;
        text-align: right;
        transition:
          transform 180ms ease,
          border-color 180ms ease,
          box-shadow 180ms ease;
      }

      .unit-card:hover,
      .unit-card:focus-visible,
      .unit-card.selected {
        transform: translateY(-3px);
        border-color: rgba(156, 111, 56, 0.48);
        box-shadow: 0 18px 42px rgba(20, 18, 14, 0.12);
        outline: none;
      }

      .unit-card::before {
        content: "";
        position: absolute;
        inset-inline-start: 0;
        inset-block: 0;
        width: 5px;
        background: var(--unit-color, #8e8374);
      }

      .unit-card[data-status="Available"] {
        --unit-color: #5f715d;
      }

      .unit-card[data-status="Reserved"] {
        --unit-color: #d9b565;
      }

      .unit-card[data-status="Sold"] {
        --unit-color: #5d7f85;
      }

      .unit-card[data-status="Pending Payment"] {
        --unit-color: #b77942;
      }

      .unit-head {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: start;
      }

      .unit-head strong {
        color: #171512;
        font-size: 1.12rem;
        font-weight: 900;
      }

      .unit-meta {
        display: grid;
        gap: 4px;
        margin: 10px 0;
        color: #675e51;
        font-size: 0.84rem;
        font-weight: 800;
      }

      .unit-client {
        color: #171512;
        font-weight: 900;
        min-height: 24px;
      }

      .mini-money {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        color: #685d4d;
        font-size: 0.78rem;
        font-weight: 800;
      }

      .mini-track {
        position: relative;
        overflow: hidden;
        height: 7px;
        margin-top: 7px;
        border-radius: 999px;
        background: rgba(20, 18, 14, 0.12);
      }

      .mini-fill {
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        width: 0%;
        border-radius: inherit;
        background: var(--unit-color, #d9b565);
      }

      .client-table-wrap {
        margin-top: 14px;
        overflow-x: auto;
      }

      .client-table {
        min-width: 940px;
        width: 100%;
        border-collapse: collapse;
      }

      .client-table th,
      .client-table td {
        padding: 11px 10px;
        border-bottom: 1px solid rgba(20, 18, 14, 0.09);
        text-align: right;
        font-size: 0.88rem;
      }

      .client-table th {
        color: #51483b;
        background: rgba(238, 226, 204, 0.72);
        font-weight: 900;
      }

      .client-table td {
        color: #2f2a23;
        font-weight: 750;
      }

      .table-action,
      .small-action {
        min-height: 34px;
        border: 1px solid rgba(20, 18, 14, 0.14);
        border-radius: 6px;
        color: #171512;
        background: rgba(255, 255, 255, 0.78);
        cursor: pointer;
        padding: 0 10px;
        font-weight: 900;
      }

      .table-action:hover,
      .small-action:hover,
      .table-action:focus-visible,
      .small-action:focus-visible {
        border-color: rgba(156, 111, 56, 0.5);
        outline: none;
      }

      .admin-side-stack {
        display: grid;
        gap: 14px;
      }

      .side-tabs {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
        margin: 14px 0;
      }

      .side-tab {
        min-height: 38px;
        border: 1px solid rgba(20, 18, 14, 0.12);
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.58);
        cursor: pointer;
        color: #3d352b;
        font-size: 0.84rem;
        font-weight: 900;
      }

      .side-tab.active {
        color: var(--paper);
        background: #171512;
      }

      .side-panel {
        display: none;
      }

      .side-panel.active {
        display: block;
      }

      .selected-unit-empty {
        display: grid;
        place-items: center;
        min-height: 160px;
        border: 1px dashed rgba(20, 18, 14, 0.18);
        border-radius: var(--radius);
        color: #716656;
        text-align: center;
        font-weight: 900;
        padding: 18px;
      }

      .payment-admin-list {
        display: grid;
        gap: 8px;
        margin-top: 12px;
      }

      .payment-row-card {
        border: 1px solid rgba(20, 18, 14, 0.1);
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.62);
        padding: 10px;
      }

      .payment-row-card strong {
        color: #171512;
        direction: ltr;
        display: inline-block;
        font-weight: 900;
      }

      .payment-row-card span {
        display: block;
        color: #675e51;
        font-size: 0.82rem;
        font-weight: 800;
      }

      .row-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 8px;
      }

      .danger-action {
        color: #6e2b35;
        border-color: rgba(110, 43, 53, 0.22);
      }

      .empty-state {
        border: 1px dashed rgba(20, 18, 14, 0.18);
        border-radius: var(--radius);
        padding: 18px;
        color: #6e6354;
        text-align: center;
        font-weight: 900;
        background: rgba(255, 255, 255, 0.46);
      }

      @media (max-width: 1120px) {
        .reservation-heading,
        .client-access-layout,
        .dashboard-grid,
        .admin-tools {
          grid-template-columns: 1fr;
        }

        .admin-overview {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        .reservation-heading h2 {
          font-size: 2.35rem;
        }

        .portal-tabs,
        .admin-search,
        .form-grid,
        .payment-numbers,
        .info-strip,
        .apartment-card-layout,
        .apartment-models-grid {
          grid-template-columns: 1fr;
        }

        .admin-overview {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .floor-row {
          grid-template-columns: 1fr;
          border: 1px solid rgba(20, 18, 14, 0.1);
          border-radius: var(--radius);
          padding: 10px;
          background: rgba(255, 255, 255, 0.48);
        }

        .floor-label {
          min-height: 54px;
        }

        .payment-table,
        .payment-table thead,
        .payment-table tbody,
        .payment-table tr,
        .payment-table th,
        .payment-table td {
          display: block;
        }

        .payment-table thead {
          display: none;
        }

        .payment-table tr {
          border: 1px solid rgba(20, 18, 14, 0.1);
          border-radius: 6px;
          margin-bottom: 10px;
          background: rgba(255, 255, 255, 0.58);
        }

        .payment-table td {
          display: flex;
          justify-content: space-between;
          gap: 14px;
        }

        .payment-table td::before {
          content: attr(data-label);
          color: #6c6152;
          font-weight: 900;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav container" aria-label="التنقل الرئيسي">
        <a class="brand" href="#top" aria-label="مشروع أرض عبدالجليل">
          <strong data-project-name>مشروع أرض عبدالجليل</strong>
          <span data-project-location>أرض عبدالجليل</span>
        </a>

        <div class="nav-links" aria-label="روابط الصفحات">
          <a href="#timeline">مراحل الإنشاء</a>
          <a href="#updates">آخر التحديثات</a>
          <a href="#gallery">معرض الصور</a>
          <a href="#stats">بيانات المشروع</a>
          <a href="#reservation-access">الحجز الخاص</a>
        </div>

        <a class="nav-action" href="#contact">تواصل معنا</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-media" aria-hidden="true">
          <img
            src="media/facade.jpg"
            alt="الواجهة الرئيسية لمشروع أرض عبدالجليل"
          />
        </div>
        <div class="hero-ruler" aria-hidden="true"></div>
        <div class="hero-seal" aria-hidden="true">
          <span>تقرير تنفيذ 2026</span>
        </div>

        <div class="hero-layout container">
          <div class="hero-content reveal">
            <span class="eyebrow">متابعة تنفيذ عقاري مباشر</span>
            <h1 data-project-name>مشروع أرض عبدالجليل</h1>
            <p class="hero-copy">
              تجربة متابعة فاخرة وواضحة لكل خطوة من مراحل البناء، من الأساسات
              وحتى التسليم، مع تحديثات دورية وشفافية في نسب الإنجاز والبيع.
            </p>

            <div class="hero-meta" aria-label="ملخص المشروع">
              <div class="meta-item">
                <span>الموقع</span>
                <strong data-project-location>أرض عبدالجليل</strong>
              </div>
              <div class="meta-item">
                <span>المرحلة الحالية</span>
                <strong data-current-phase>الأساس</strong>
              </div>
              <div class="meta-item">
                <span>التسليم المتوقع</span>
                <strong data-delivery-label>12 نوفمبر 2026</strong>
              </div>
            </div>
          </div>

          <aside
            class="hero-panel reveal"
            aria-label="العد التنازلي ونسبة الإنجاز"
          >
            <div class="panel-title">
              <h2>موعد التسليم</h2>
              <span data-delivery-short>نوفمبر 2026</span>
            </div>

            <div class="countdown" aria-live="polite">
              <div class="count-box">
                <strong id="days">٠</strong>
                <span>يوم</span>
              </div>
              <div class="count-box">
                <strong id="hours">٠</strong>
                <span>ساعة</span>
              </div>
              <div class="count-box">
                <strong id="minutes">٠</strong>
                <span>دقيقة</span>
              </div>
              <div class="count-box">
                <strong id="seconds">٠</strong>
                <span>ثانية</span>
              </div>
            </div>

            <div class="overall-progress">
              <div class="progress-head">
                <span>نسبة الإنجاز الكلية</span>
                <strong id="overallPercent">٠٪</strong>
              </div>
              <div class="progress-track" aria-label="نسبة الإنجاز الكلية">
                <div class="progress-fill" id="overallFill"></div>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <section id="timeline" class="container">
        <div class="section-title reveal">
          <h2>مراحل الإنشاء</h2>
          <p>
            مسار تنفيذي واضح يربط كل مرحلة بنسبة الإنجاز، حالة العمل، وتاريخ
            البداية والنهاية المتوقع.
          </p>
        </div>
        <div class="timeline" id="timelineGrid"></div>
      </section>

      <section id="updates" class="updates-section">
        <div class="container">
          <div class="section-title reveal">
            <h2>آخر التحديثات</h2>
            <p>
              سجل ميداني مرتب من الأحدث للأقدم، يعرض أهم ما تم تنفيذه داخل
              الموقع مع صور مختارة من سير العمل.
            </p>
          </div>
          <div class="updates-grid" id="updatesGrid"></div>
        </div>
      </section>

      <section id="gallery" class="container">
        <div class="section-title reveal">
          <h2>معرض الصور</h2>
          <p>
            لقطات من الموقع والمراحل المختلفة، مع تصنيفات تساعد على متابعة
            الصورة العامة للتنفيذ.
          </p>
        </div>

        <div class="filters" role="tablist" aria-label="تصنيفات الصور">
          <button class="filter-btn active" type="button" data-filter="all">
            الكل
          </button>
          <button class="filter-btn" type="button" data-filter="exterior">
            واجهة المشروع
          </button>
          <button class="filter-btn" type="button" data-filter="apartment-plan">
            نماذج الشقق
          </button>
          <button class="filter-btn" type="button" data-filter="construction">
            فيديو الإنشاء
          </button>
        </div>

        <div class="gallery-grid" id="galleryGrid"></div>
      </section>

      <section id="stats" class="container">
        <div class="section-title reveal">
          <h2>بيانات المشروع</h2>
          <p>
            أرقام مختصرة تساعد الملاك والعملاء على قراءة حالة المشروع ونسبة
            الإتاحة والبيع بسرعة.
          </p>
        </div>

        <div class="stats-layout">
          <div class="stats-visual reveal">
            <img
              src="media/facade.jpg"
              alt="مخططات معمارية وواجهة مشروع أرض عبدالجليل"
            />
            <div class="stats-badge">
              <span>نسبة البيع الحالية</span>
              <strong id="salePercentBadge">٠٪</strong>
            </div>
          </div>

          <div class="stats-grid reveal" id="statsGrid"></div>
        </div>
      </section>

      <section id="apartment-models" class="container">
        <div class="section-title reveal">
          <h2>نماذج الشقق</h2>
          <p>
            استعرض نماذج الشقق المتاحة مع تفاصيل المساحات والاتجاهات والتوزيع
            الداخلي لكل وحدة.
          </p>
        </div>

        <div class="apartment-models-grid reveal">
          <article class="apartment-model-card" data-apartment-type="A">
            <div class="model-visual">
              <img src="media/apartment-1.jpg" alt="مخطط شقة رقم 1 مساحة 137 متر" loading="lazy" />
              <div class="model-badge">نموذج أ</div>
            </div>
            <div class="model-info">
              <h3>شقة رقم 1</h3>
              <div class="model-specs">
                <span class="spec-item">137 متر — بحري قبلي</span>
              </div>
              <p>أكبر نموذج داخل الدور مع مساحة واسعة وتوزيع مميز</p>
            </div>
          </article>

          <article class="apartment-model-card" data-apartment-type="B">
            <div class="model-visual">
              <img src="media/apartment-2.jpg" alt="مخطط شقة رقم 2 مساحة 125 متر" loading="lazy" />
              <div class="model-badge">نموذج ب</div>
            </div>
            <div class="model-info">
              <h3>شقة رقم 2</h3>
              <div class="model-specs">
                <span class="spec-item">125 متر — بحري</span>
              </div>
              <p>نموذج متوسط المساحة بتوزيع عملي وميزات مثالية</p>
            </div>
          </article>

          <article class="apartment-model-card" data-apartment-type="C">
            <div class="model-visual">
              <img src="media/apartment-3.jpg" alt="مخطط شقة رقم 3 مساحة 120 متر" loading="lazy" />
              <div class="model-badge">نموذج ج</div>
            </div>
            <div class="model-info">
              <h3>شقة رقم 3</h3>
              <div class="model-specs">
                <span class="spec-item">120 متر — قبلي</span>
              </div>
              <p>نموذج مناسب للعائلات بتقسيم واضح ومساحات عملية</p>
            </div>
          </article>
        </div>
      </section>

      <section id="project-updates-admin" class="admin-section container" style="display: none;">
        <div class="section-title reveal">
          <h2>إدارة آخر التحديثات</h2>
          <p>
            إضافة وتعديل وحذف تحديثات المشروع مع إدارة الوسائط المرئية والنشر.
          </p>
        </div>

        <div class="admin-actions reveal">
          <button class="btn primary" onclick="showUpdateForm()">
            <span>+</span> إضافة تحديث جديد
          </button>
        </div>

        <div class="admin-table-container reveal">
          <table class="admin-updates-table" id="updatesTable">
            <thead>
              <tr>
                <th>العنوان</th>
                <th>المرحلة</th>
                <th>التاريخ</th>
                <th>نوع الوسائط</th>
                <th>الحالة</th>
                <th>ترتيب الظهور</th>
                <th>الإجراءات</th>
              </tr>
            </thead>
            <tbody id="updatesTableBody">
              <!-- Updates will be loaded here -->
            </tbody>
          </table>
        </div>

        <!-- Update Form Modal -->
        <div class="modal-overlay" id="updateFormModal" style="display: none;">
          <div class="modal-content">
            <div class="modal-header">
              <h3 id="updateFormTitle">إضافة تحديث جديد</h3>
              <button class="modal-close" onclick="hideUpdateForm()">&times;</button>
            </div>
            <form class="update-form" id="updateForm" onsubmit="saveUpdate(event)">
              <div class="form-grid">
                <div class="form-field">
                  <label for="updateTitle">عنوان التحديث</label>
                  <input type="text" id="updateTitle" name="title" required>
                </div>
                <div class="form-field">
                  <label for="updateDate">تاريخ التحديث</label>
                  <input type="date" id="updateDate" name="update_date" required>
                </div>
                <div class="form-field">
                  <label for="updateStage">مرحلة المشروع</label>
                  <select id="updateStage" name="stage" required>
                    <option value="">اختر المرحلة</option>
                    <option value="foundation">الأساسات</option>
                    <option value="concrete">أعمال الخرسانة</option>
                    <option value="walls">أعمال المباني</option>
                    <option value="finishing">التشطيبات</option>
                    <option value="exterior">الواجهة</option>
                    <option value="delivery">التسليم</option>
                    <option value="general">عام</option>
                  </select>
                </div>
                <div class="form-field">
                  <label for="updateDescription">وصف التحديث</label>
                  <textarea id="updateDescription" name="description" rows="4" required></textarea>
                </div>
                <div class="form-field">
                  <label for="updateMediaType">نوع الوسائط</label>
                  <select id="updateMediaType" name="media_type" required onchange="toggleMediaFields()">
                    <option value="">اختر النوع</option>
                    <option value="image">صورة</option>
                    <option value="video">فيديو</option>
                  </select>
                </div>
                <div class="form-field" id="imageField" style="display: none;">
                  <label for="updateImage">رفع صورة</label>
                  <input type="file" id="updateImage" name="image" accept="image/*">
                  <div id="imagePreview" style="margin-top: 10px;"></div>
                </div>
                <div class="form-field" id="videoField" style="display: none;">
                  <label for="updateVideo">رفع فيديو</label>
                  <input type="file" id="updateVideo" name="video" accept="video/*">
                  <div id="videoPreview" style="margin-top: 10px;"></div>
                </div>
                <div class="form-field">
                  <label for="updateStatus">حالة النشر</label>
                  <select id="updateStatus" name="status">
                    <option value="draft">مسودة</option>
                    <option value="published">منشور</option>
                  </select>
                </div>
                <div class="form-field">
                  <label for="updateOrder">ترتيب الظهور</label>
                  <input type="number" id="updateOrder" name="display_order" min="0" value="0">
                </div>
              </div>
              <div class="form-actions">
                <button type="button" class="btn secondary" onclick="hideUpdateForm()">إلغاء</button>
                <button type="submit" class="btn primary">حفظ</button>
              </div>
            </form>
          </div>
        </div>
      </section>

      <section id="reservation-access" class="reservation-section">
        <div class="reservation-shell container">
          <div class="reservation-heading reveal">
            <div>
            <span class="reservation-kicker">بوابة الحجز الخاصة</span>
              <h2>بوابة الحجز الخاصة وخريطة توفر الشقق</h2>
            </div>
            <p>
              مركز تحكم فاخر للحجوزات والمدفوعات: يدخل العميل كوده الخاص ليرى
              وحدته فقط، بينما يدير المكتب الشقق والعملاء والمدفوعات من مساحة
              منفصلة.
            </p>
          </div>

          <div
            class="portal-tabs reveal"
            role="tablist"
            aria-label="أقسام بوابة الحجز الخاصة"
          >
            <button
              class="portal-tab active"
              type="button"
              id="clientPortalTab"
              data-portal-tab="client"
              role="tab"
              aria-selected="true"
              aria-controls="clientPortalPanel"
            >
              بوابة العميل
            </button>
            <button
              class="portal-tab"
              type="button"
              id="adminPortalTab"
              data-portal-tab="admin"
              role="tab"
              aria-selected="false"
              aria-controls="adminPortalPanel"
            >
              لوحة المكتب
            </button>
            <button
              class="portal-tab"
              type="button"
              id="updatesAdminTab"
              data-portal-tab="updates-admin"
              role="tab"
              aria-selected="false"
              aria-controls="projectUpdatesAdminPanel"
            >
              إدارة التحديثات
            </button>
          </div>

          <div
            class="portal-panel active"
            id="clientPortalPanel"
            role="tabpanel"
            aria-labelledby="clientPortalTab"
          >
            <div class="client-access-layout">
              <article class="client-access-card reveal" dir="rtl">
                <h3>الدخول الخاص ببيانات الحجز</h3>
                <p>
                  أدخل كود الحجز الخاص بك للاطلاع على تفاصيل الشقة، حالة الحجز،
                  والمدفوعات الخاصة بك.
                </p>

                <form class="code-form" id="clientCodeForm" novalidate>
                  <div class="form-field">
                    <label for="reservationCode">كود الحجز</label>
                    <input
                      id="reservationCode"
                      name="reservationCode"
                      type="text"
                      inputmode="text"
                      autocomplete="one-time-code"
                      placeholder="مثال: GEO-HS-8F42X"
                      aria-describedby="clientCodeMessage"
                    />
                  </div>
                  <button
                    class="btn primary"
                    type="submit"
                    id="clientCodeButton"
                  >
                    عرض بيانات الحجز
                  </button>
                  <div
                    class="access-error"
                    id="clientCodeMessage"
                    role="status"
                    aria-live="polite"
                  ></div>
                  <div
                    class="access-success"
                    id="clientSuccessMessage"
                    role="status"
                    aria-live="polite"
                  ></div>
                </form>

                <div class="portal-note">
                  يتم عرض بيانات الحجز المطابقة للكود فقط. في النسخة الحقيقية
                  يتم استبدال هذا التحقق بطلب آمن إلى الخادم.
                </div>
              </article>

              <article class="access-preview reveal">
                <h3>تفاصيل وحدتك ومدفوعاتك في مساحة واحدة.</h3>
                <p>
                  ملخص دقيق للوحدة المختارة، المدفوع، المتبقي، وسجل الدفعات بدون
                  كشف بيانات أي عميل آخر.
                </p>
              </article>
            </div>

            <div
              class="private-dashboard"
              id="clientDashboard"
              aria-live="polite"
            ></div>
          </div>

          <div
            class="portal-panel"
            id="adminPortalPanel"
            role="tabpanel"
            aria-labelledby="adminPortalTab"
          >
            <article class="admin-gate reveal" id="adminGate">
              <h3>تسجيل دخول الإدارة</h3>
              <p>
                لوحة الإدارة محمية بحساب مسؤول، بينما يظل دخول العملاء منفصلًا بكود الحجز فقط.
              </p>

              <form class="admin-code-form" id="adminCodeForm" novalidate>
                <div class="form-field">
                  <label for="adminEmail">البريد الإلكتروني</label>
                  <input
                    id="adminEmail"
                    name="adminEmail"
                    type="email"
                    autocomplete="username"
                    placeholder="admin@example.com"
                    aria-describedby="adminCodeMessage"
                  />
                </div>
                <div class="form-field">
                  <label for="adminCode">كلمة المرور</label>
                  <input
                    id="adminCode"
                    name="adminCode"
                    type="password"
                    autocomplete="current-password"
                    placeholder="•••••••••••"
                    aria-describedby="adminCodeMessage"
                  />
                </div>
                <button class="btn primary" type="submit" id="adminCodeButton">
                  تسجيل الدخول
                </button>
                <div
                  class="access-error"
                  id="adminCodeMessage"
                  role="status"
                  aria-live="polite"
                ></div>
              </form>
            </article>

            <div class="admin-dashboard" id="adminDashboard">
              <div class="admin-topline">
                <div>
                  <h3>خريطة توفر الشقق</h3>
                  <p>
                    خريطة توفر الشقق داخل المبنى، مع متابعة الحجز والمدفوعات لكل
                    وحدة.
                  </p>
                </div>
                <div class="contact-actions">
                  <button
                    class="btn secondary"
                    type="button"
                    id="refreshAdminButton"
                  >
                    تحديث الحسابات
                  </button>
                  <button
                    class="btn secondary"
                    type="button"
                    id="exportClientsButton"
                  >
                    تصدير العملاء Excel
                  </button>
                  <button
                    class="btn secondary"
                    type="button"
                    id="exportPaymentsButton"
                  >
                    تصدير المدفوعات Excel
                  </button>
                  <button
                    class="btn secondary"
                    type="button"
                    id="exportApartmentsButton"
                  >
                    تصدير الشقق Excel
                  </button>
                  <button
                    class="btn secondary"
                    type="button"
                    id="exportInstallmentsButton"
                  >
                    تصدير الأقساط Excel
