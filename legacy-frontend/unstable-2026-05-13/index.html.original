        },
        {
            category: "construction",
            label: "فيديو متابعة الإنشاء",
            title: "فيديو متابعة الإنشاء",
            description: "مشاهدة آخر تحديثات تنفيذ المشروع على أرض الواقع",
            video: "media/project-video.mp4",
