    ];

    // Legacy compatibility - convert to galleryItems format
    const galleryItems = [
        {
            category: "exterior",
            label: "واجهة المشروع",
            title: "واجهة المشروع",
            description: "الواجهة الرئيسية لمشروع أرض عبدالجليل",
