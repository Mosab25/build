# PostgreSQL connection string.
# Required. Use your own credentials outside this example file.
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>

# Flask/session secret. Use a long random value in production.
SECRET_KEY=<replace-with-random-secret>

# development or production. Production requires a real SECRET_KEY and secure cookies.
APP_ENV=development

# Runtime upload directory, relative to the project root unless absolute.
UPLOAD_FOLDER=uploads

# Optional one-time owner bootstrap for hosted environments.
BOOTSTRAP_OWNER=false
OWNER_EMAIL=<owner@example.com>
OWNER_PASSWORD=<replace-with-strong-password>
OWNER_NAME=<Owner Name>

# Optional production media storage. When set, project update uploads go to Cloudinary.
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
