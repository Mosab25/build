# PostgreSQL Database Connection.
# Required. The app will not start without DATABASE_URL.
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/real_estate

# Flask/session secret. Change in production.
SECRET_KEY=change-this-secret

# development or production. Production requires a real SECRET_KEY and secure cookies.
APP_ENV=development

# Runtime upload directory, relative to the project root unless absolute.
UPLOAD_FOLDER=uploads
